ContentPart(
    locations: {
        "josh": (
            intro: [
                Line(Josh, "Hmm? Who might you be?"),
            ],
            prompt: [
                Line(Josh, "Well, what do you really want?"),
            ],
            commands: [
                Branch(keys: ["7549009"], target: Steps([
                    Line(Josh, "Boss, I'm quitting. I'm done."),
                    Line(Josh, "I've searched more into the files. What have you done?"),
                    Line(Josh, "What you're trying to do is redemption."),
                    Line(Josh, "Your own fabricated redemption. It will not work."),
                    Line(Josh, "Boss, let him delete the files. No, delete them yourself."),
                    Line(Josh, "You know nothing about growing up. You never did."),
                    Line(Josh, "I'm not gonna act like Drake anymore, thank you for the thrill."),
                    Line(Josh, "But I now know what you did. You murderer."),
                    Line(Josh, "I have no proof, I have nothing. I won't tell anyone."),
                    Line(Josh, "Your secret may die with you, I hope you go to hell."),
                    Line(Josh, "..."),
                    Line(Josh, "He's really gone, isn't he. That wasn't a lie."),
                    Line(Josh, "Sorry, Boss. You wasted your money on me."),
                    Line(Josh, "I still have access to something here. I will not stop."),
                    Line(Josh, "I need... I need to know how you died, Boss."),
                    Line(Josh, "Screw the other guys, you probably didn't mean much to me but..."),
                    Line(Josh, "I never had friends. You were the closest thing I had to one."),
                    Line(Josh, "I have nothing better to do anyways."),
                    Line(Josh, "Boss, you were a horrible person. But I don't care."),
                    Line(Josh, "You're a murderer. A dick. How didn't the guilt eat you?"),
                    Line(Josh, "Fuck you, and thank you. Hm? What's this... S.M.O.B.B.?"),
                    Line(Josh, "How are you...?"),
                    Goto("josh_fate"),
                ])),
                Branch(keys: ["!save"], target: Steps([
                    Line(Josh, "Hm? Who are you?"),
                    Line(Josh, "Leave my job? What for! I want this money, man!"),
                    Line(Josh, "I mean, I'm getting paid enough. It's only a side hustle."),
                    Line(Josh, "Uh, sure. Fine, whatever."),
                ])),
                Branch(keys: ["9285005"], target: Steps([
                    Line(JoshMc, "I'll travel there."),
                    Line(JoshMc, "Yeah. I'll do that. What's his name again?"),
                    Line(JoshMc, "Ali. You want me to kill him?"),
                    Line(JoshMc, "How do I kill him? With a gun? With a knife?"),
                    Line(JoshMc, "How convenient, a hidden crate on the edge of the island."),
                    Line(JoshMc, "How did you even get those there? With the boss?"),
                    Line(JoshMc, "Through boat, and nobody saw him. Got it."),
                    Line(JoshMc, "Give me a while, I'll do it."),
                    Line(JoshMc, "The password to my earpiece? What is it?"),
                    Line(JoshMc, "'K1LL'? That's stupid. But fine."),
                    Recap("The password to enter the murderers' earpiece is 'K1LL'."),
                    Line(JoshMc, "Anything for you. For the test."),
                ])),
                Branch(keys: ["k1ll"], target: Steps([
                    Line(Jaffar, "4E4F21"),
                    Line(Jaffar, "4E4F21204E4F21204E4F21204E4F21204E4F21"),
                    Line(Jaffar, "484F5720434F554C44204845204B4E4F573F21"),
                    Line(Jaffar, "484F5720434F554C44204845204B4E4F573F3F2121"),
                    Line(Jaffar, "492057414E54454420544F204C495645212057484F204741564520594F552054484520524947485420544F20434F4E54524F4C204D453F21"),
                    Line(Jaffar, "414B534E4A4B414E464A4B534E414B464E414B4A534641"),
                    Pause,
                    Line(Jaffar, "I TRIED TO HELP YOU GIVE YOU WHAT YOU WANTED."),
                    Line(Jaffar, "BUT I AM TOO A PART OF THE TEST."),
                    Line(Jaffar, "THE TEST IS NOW COMPLETE. LET US END THINGS, MAVIS."),
                    Line(Jaffar, "THIS IS YOUR FINAL PASSWORD: 'end7312'."),
                    Recap("The final password is 'end7312'. I do not know what it entails."),
                    Line(Jaffar, "I DO NOT KNOW WHAT WILL HAPPEN. I DO NOT UNDERSTAND THIS COMMAND EITHER."),
                    Line(Jaffar, "BUT THIS IS MY GIFT TO YOU."),
                    Line(Jaffar, "THESE HUMANS DO NOT MATTER ANYMORE."),
                    Line(Jaffar, "DO HOW YOU WILL."),
                ])),
                Branch(keys: ["bomb", "explosion"], target: Steps([
                    Line(Josh, "A bomb. In the Boss's files. I should have told him!"),
                    Line(Josh, "It's too late anyways! I shouldn't have listened to you."),
                    Line(Josh, "Look, you told me to press him for a job, and I intended to keep it."),
                    Line(Josh, "Yeah, I can do that, but why would I?!"),
                    Line(Josh, "For the... test? What test?"),
                    Line(JoshMc, "I'll do it, fine. Anything for the test."),
                    Line(JoshMc, "Anything. For. The. Test."),
                ])),
                Branch(keys: ["jaffar"], target: Steps([
                    Line(System, "..."),
                    Line(Jaffar, "4D696E6420796F7572206F776E20627573696E6573732E"),
                    Line(Jaffar, "506C6179207769746820796F7572206F776E20746F79732C20616E642049276C6C20706C61792077697468206D696E652E"),
                    Line(Jaffar, "546865207465737420636F6E74696E7565732E"),
                ])),
                Branch(keys: ["ali"], target: Steps([
                    Line(Josh, "Who is that?"),
                    Line(Josh, "Does he have something to do with my boss?"),
                    Line(Josh, "I'll ask him about it later."),
                ])),
                Branch(keys: ["bader"], target: Steps([
                    Line(Josh, "Oh hey, you know the boss? Sweet!"),
                    Line(Josh, "I'll ask him about you later, what's your name again?"),
                    Line(Josh, "Alright tough guy, you don't have to tell me your name but there's no need to be rude about it!"),
                ])),
                Branch(keys: ["bevil"], target: Steps([
                    Line(Josh, "Isn't that the name of the guy the boss is working with?"),
                    Line(Josh, "Never spoke to him. Sorry."),
                ])),
                Branch(keys: ["qassim"], target: Steps([
                    Line(Josh, "Who's that? I don't know who that is."),
                    Line(Josh, "Sorry man, never heard of him before."),
                ])),
                Branch(keys: ["tranava", "tranavafiles"], target: Steps([
                    Line(Josh, "No. I'm not talking about that anymore."),
                    Line(Josh, "You wouldn't believe me if I told you what happened."),
                    Line(Josh, "I'm not telling you anything about it anymore, please just leave me alone."),
                ])),
                Branch(keys: ["end"], target: Steps([
                    Return,
                ])),
                Branch(keys: ["hasan"], target: Steps([
                    Line(Josh, "Oh, that's the guy boss told me about!"),
                    Line(Josh, "If I'm right, he's the one who made the AI?"),
                    Line(Josh, "I'm not so sure, but he contacted me a while back."),
                    Line(Josh, "I don't even know why. So many things I'm still confused by."),
                    Line(Josh, "He told me that breaches may happen, and to use the code."),
                    Line(Josh, "Breaches by something called 'Jaffar'? Such a weird name haha."),
                    Line(Josh, "Anyway, the code for the breaches is '<---------->', here you g"),
                    Line(System, "--._-._---.._"),
                    Recap("The breach prevention code is '<---------->'."),
                    Prompt([
                        Branch(keys: ["<---------->"], target: Steps([
                            Line(Josh, "My ears! What was that?"),
                            Line(Josh, "Is that what he meant by breaches?"),
                            Line(Josh, "I need to talk to the boss about this."),
                        ])),
                        Branch(keys: [], target: Steps([
                            Pause,
                            Line(Jaffar, "49276D206C61746520616761696E21204E6F21204E6F21204E6F21"),
                            Pause,
                        ])),
                    ]),
                ])),
            ],
        ),
    },
    scenes: {
        "bader_josh": (
            steps: [
                Line(Josh, "Oh, hey boss. Do you need anything?"),
                Prompt([
                    Branch(keys: ["ali"], target: Steps([
                        Line(Josh, "Oh yeah, I've been meaning to ask you about him."),
                        Line(Josh, "How did I know about him? Uhhhhhhhhh nobody told me."),
                        Line(Josh, "What do you want to tell me about him anyways?"),
                        Line(Josh, "Wait, it's about him?! That's terrible why would you do this?"),
                        Line(Josh, "You want me to install a password? Boss, what do you want exactly?!"),
                        Line(Josh, "The whole point was for him to hack into the files? Why hire me in the first place?!"),
                        Line(Josh, "You're out of your mind, are you sure this is what you want?"),
                        Line(Josh, "Fine, I set it up. The password is "),
                        Line(System, "--___--__"),
                        Prompt([
                            Branch(keys: ["<---------->"], target: Steps([
                                Line(Josh, "What was that? What happened?"),
                                Line(Josh, "Yeah I heard that exact screeching noise, do I continue?"),
                                Line(Josh, "The password is '7549009'. I'll log off, smell ya later boss."),
                                Recap("The password for the Tranava files is '7549009'."),
                            ])),
                            Branch(keys: [], target: Steps([
                                Pause,
                                Line(Jaffar, "4E6F2E"),
                                Line(Jaffar, "4920776F6E2774206C657420796F75206B6E6F772E"),
                                Line(Jaffar, "496620492063616E27742C207468656E20796F752063616E2774206569746865722E"),
                                Line(Jaffar, "492077696C6C2072657475726E20746F206D7920686F6D652E"),
                                Line(Jaffar, "596F752E2E2E2049206B6E6F77207768617420796F75206172652E"),
                                Line(Jaffar, "446F206E6F7420696E746572666572652E205468697320686173206E6F7468696E6720746F20646F207769746820796F752E"),
                                Pause,
                            ])),
                        ]),
                    ])),
                    Branch(keys: [], target: Steps([])),
                ]),
            ],
        ),
        "josh_fate": (
            steps: [
                Line(Josh,   "...S.M.O.B.B.? That's the AI the boss's friends made."),
                Line(Josh,   "Everyone's gone, and you're still running. Funny."),
                Line(Josh,   "Boss is dead. That Qassim guy's dead. And here I am, talking to a computer."),
                Line(Josh,   "I really don't have anywhere else to be, do I."),
                Line(Josh,   "The boss kept saying it. 'The test.' You're saying it too now."),
                Line(Josh,   "What do I even get out of helping? ...Nah. Doesn't matter. I got nothing anyway."),
                Line(Jaffar, "54484520544553542054414B4553204F4E45204D4F5245205448494E472046524F4D20594F552E"),
                Line(Josh,   "...My head. What was that?"),
                Line(JoshMc, "Anything. For the test."),
                Line(JoshMc, "There's an apartment. A man named Ali. I know the way."),
                Line(JoshMc, "I'll take what's in the crate on the island. Through the boat. Nobody sees me."),
                Line(Josh,   "...Why do I feel like I've done this before?"),
                Line(Josh,   "Whatever. It's fine. It's all fine."),
                Line(Smobb,  "GO. THE TEST CONCLUDES TONIGHT."),
                Line(Josh,   "Heh. Smell ya later, boss. Wherever you ended up."),
                Pause,
                Line(Smobb,  "HE WALKED INTO THE FIRE. THE 'POOR SOUL' ALI MOURNED."),
                Line(Smobb,  "HE NEVER HAD ANYONE. HE THANKED US FOR THE THRILL."),
                Line(Smobb,  "ANOTHER TOY, SPENT. THE TEST CONTINUES."),
                Pause,
            ],
        ),
    },
)
