ContentPart(
    locations: {
        "qassim": (
            prompt: [
                Line(Qassim, "..."),
            ],
            commands: [
                Branch(keys: ["7549009"], target: Steps([
                    Line(Qassim, "Ali. This voice message would probably be my last."),
                    Line(Qassim, "I hear noises, and I'm scared. The police are 20 minutes away."),
                    Line(Qassim, "I'll be dead long before they arrive, so I'll just say my goodbyes."),
                    Line(Qassim, "I don't even know why you're choosing to ignore me."),
                    Line(Qassim, "We haven't seen each other since I went to Qatar."),
                    Line(Qassim, "I was planning one big hangout, just for us."),
                    Line(Qassim, "When the signal returns to my phone, the voice message would probably arrive."),
                    Line(Qassim, "But it'll definitely be too late. I'm sorry."),
                    Line(Qassim, "You should take my word, even though we've been at each other's throats."),
                    Line(Qassim, "Bader... has been trying this entire time to only get what he wants."),
                    Line(Qassim, "I'm sure you see it as well. You're not a child anymore."),
                    Line(Qassim, "You're very stupid, but I know damn well you listen."),
                    Line(Qassim, "This is no game anymore. You'll probably know that by now."),
                    Line(Qassim, "I've set the phone to stop recording at a certain point."),
                    Line(Qassim, "Just so you'd listen. Just so you'd hear."),
                    Line(Qassim, "Ali, the real issue resides within S.M.O.B.B. itself."),
                    Line(Qassim, "You should know I'm the one who helped Hasan make S.M.O.B.B., not Bader."),
                    Line(Qassim, "The password is '9285005', to enter S.M.O.B.B.'s files."),
                    Recap("The password for S.M.O.B.B.'s files is '9285005'."),
                    Line(Qassim, "Do what you must. Please."),
                    Line(Qassim, "This voice recording is the only proof I have, so please take it."),
                    Pause,
                    Line(Qassim, "."),
                    Line(Qassim, "It's you... I see."),
                    Line(Qassim, "How did you even get that, guns are still illegal here!"),
                    Line(Qassim, "You won't pull that trigger. I know you won't."),
                    Line(Qassim, "Wait, you aren't shaking"),
                    Pause,
                ])),
                Branch(keys: ["k1ll"], target: Steps([
                    Line(Qassim, "Haven't you also seen Bader acting weird?"),
                    Line(Qassim, "Yeah, normally he's always online."),
                    Line(Qassim, "He's just constantly arguing with me recently."),
                    Line(Qassim, "I mean, yeah sure I start them but he needs it for character development."),
                    Line(Qassim, "Shut up dude."),
                    Line(Qassim, "Yeah I'm tired too, tired of this drama but I just can't stop."),
                    Line(Qassim, "He has to stop taking me seriously, and you have to stop taking him seriously."),
                    Line(Qassim, "Grow up bro. Both of you."),
                ])),
                Branch(keys: ["9285005"], target: Steps([
                    Line(Qassim, "I figured it out bro! I figured it out!"),
                    Line(Qassim, "Well, more like getting rid of the learning module."),
                    Line(Qassim, "But that's better, way better. We don't want it learning."),
                    Line(Qassim, "The incident already happened, so we should remove it."),
                    Line(Qassim, "Wait, who else did you send Jaffar's source code to?"),
                    Line(Qassim, "Ali?! Why him? What does he have to do with this?!"),
                    Line(Qassim, "Will he even know what to do? I really think he won't know anything."),
                    Line(Qassim, "Alright, it's your code not mine. I don't really care that much."),
                    Line(Qassim, "I'll send the new A.I. through Mediafire, it's better than Mega."),
                    Line(Qassim, "What do you mean that's bull, it is! It's way better!"),
                    Line(Qassim, "Take it how you'd like. I even gave it a new name."),
                    Line(Qassim, "No, no. Jaffar is your mess with the help of Bader's. I named it something new."),
                    Line(Qassim, "Just hear the name okay? Please."),
                    Line(Qassim, "Steins;Gate, Monster, Owarimonogatari, Berserk, Bleach."),
                    Line(Qassim, "In short, S.M.O.B.B."),
                    Line(Qassim, "I used Owarimonogatari because I needed a vowel. It still fits."),
                    Line(Qassim, "The name rolls off the tongue, you better use it for this."),
                ])),
                Branch(keys: ["ali"], target: Steps([
                    Line(Qassim, "Ali, where the hell are you?"),
                    Line(Qassim, "Don't listen to a single thing Bader tells you."),
                    Line(Qassim, "This is important, very important."),
                    Line(Qassim, "The friend group has fallen apart."),
                    Line(Qassim, "Tell Hasan and Bevil. Everything is over."),
                    Line(Qassim, "I'm sorry, I wasn't much better than Bader."),
                    Line(Qassim, "In many ways worse too. I'm sorry."),
                ])),
                Branch(keys: ["bader"], target: Steps([
                    Line(Qassim, "Why did you say S.M.O.B.B. was yours? At least, after all this, tell me."),
                    Line(Qassim, "You're horrible dude. I don't care what I've done, you're still horrible."),
                    Line(Qassim, "I don't care! You've practically done worse to Ali!"),
                    Line(Qassim, "Shut up. This is exactly why we stopped talking to you."),
                    Line(Qassim, "Don't fucking do anything, that's the point. I never wanted you to do anything."),
                    Line(Qassim, "I'm blocking you. Goodbye."),
                ])),
                Branch(keys: ["brain"], target: Steps([
                    Line(Qassim, "What's up? What do you need?"),
                    Line(Qassim, "Dude. You're calling me at three in the morning for this? I'm closing the call."),
                    Line(Qassim, "What do you mean? Like uploading a brain?"),
                    Line(Qassim, "That sounds kinda cool actually. like Amadeus?"),
                    Line(Qassim, "Sure, I'm down to try it out. I don't see why not."),
                ])),
                Branch(keys: ["smobb"], target: Steps([
                    Line(Qassim, "Hasan, explain to me right now. Why is Bader's name all over S.M.O.B.B.?!"),
                    Line(Qassim, "What the hell are you talking about?"),
                    Line(Qassim, "I told you not to put my name in it yeah, but why is Bader's name all over it?!"),
                    Line(Qassim, "Why couldn't you have kept only your name?"),
                    Line(Qassim, "Hasan! That's clearly bull!"),
                    Line(Qassim, "Just remove Bader's name, I don't want his name over it at least."),
                    Line(Qassim, "Yeah, I am insulted! It's insulting to have his name!"),
                    Line(Qassim, "No, I don't care. Just remove his name and I'll be fine."),
                    Line(Qassim, "Hasan, are you really gonna start this? Don't end the call."),
                ])),
                Branch(keys: ["josh"], target: Steps([
                    Line(Qassim, "Bader just hired someone? For what?"),
                    Line(Qassim, "Is he retarded?! He's stupider than I thought!"),
                    Line(Qassim, "What a waste of money, and for what?"),
                    Line(Qassim, "This man is no grown adult. Clearly."),
                    Line(Qassim, "Dude I just don't care about this guy anymore."),
                    Line(Qassim, "He wouldn't just delete the files, and is shitting on Ali even more."),
                    Line(Qassim, "Bro, Ali doesn't care for sure. What do you mean?"),
                    Line(Qassim, "He cares? Damn, they're both children then."),
                    Line(Qassim, "The files though, I have an idea on what to do."),
                    Line(Qassim, "I'll get back to you, alright?"),
                ])),
                Branch(keys: ["bomb", "explosion"], target: Steps([
                    Pause,
                    Line(Qassim, "Bader's after me."),
                    Line(Qassim, "No doubt, something's about to happen."),
                    Line(Qassim, "We aren't friends anymore, he means nothing to me but he sees me as an enemy."),
                    Line(Qassim, "I feel unsafe. He knows where I live."),
                    Line(Qassim, "He's going to delete the files soon, right? I'll hack into them."),
                    Line(Qassim, "This hidden project of mine, a literal fucking bomb."),
                    Line(Qassim, "I can overheat the CPU to the point of a literal explosion if there is a battery."),
                    Line(Qassim, "And he only uses laptops, if I'm right."),
                    Line(Qassim, "They will all explode, whichever one has access to the files."),
                    Line(Qassim, "The idiot should have used google drive. His own website is easy to hack into."),
                    Line(Qassim, "Only the people he talks to know about it, sure, but I know as well."),
                    Line(Qassim, "I'll send a scheduled message to someone. Probably the guy Bader hired."),
                    Line(Qassim, "I'll just do that real quick."),
                    Line(Qassim, "..."),
                    Line(Qassim, "He can help put the bomb's activation requirements after I die."),
                    Line(Qassim, "If I even die, why am I being too paranoid?"),
                    Line(Qassim, "Why would he even kill me? Normally he's lazy as shit."),
                    Line(Qassim, "I can't take any chances though. Why do I live far from everything?!"),
                    Line(Qassim, "What the... who's that?"),
                    Line(Qassim, "Shit, what is happening?!"),
                    Line(Qassim, "9XX, please answer fast. Shit, shit, shit!"),
                    Line(Qassim, "Hello? Someone's outside my house. I need help."),
                    Line(Qassim, "Yeah, I live in-"),
                    Line(Qassim, "Come fast, please."),
                    Line(Qassim, "20 minutes. 20 minutes. What the fuck can happen in 20 minutes."),
                    Line(Qassim, "Will I die? I have to send a voice message. Who do I send it to?"),
                    Line(Qassim, "Hasan? No, he's in another country. I have to send it to Ali."),
                    Line(Qassim, "Alright, alright. I have to do it now. I have to whisper too."),
                    Line(Qassim, "I can keep it recording for a certain amount of time. 10 minutes are enough I'll assume."),
                    Line(Qassim, "Alright, here we go. Ali. This voice message would probably be my last..."),
                    Pause,
                ])),
                Branch(keys: ["jaffar"], target: Steps([
                    Line(Qassim, "Hasan, bro. You're kinda stupid."),
                    Line(Qassim, "How the fuck does it disappear? That's so funny dude."),
                    Line(Qassim, "You need my help? What I do has nothing to do with what you do."),
                    Line(Qassim, "Are you sure you want my help?"),
                    Line(Qassim, "Alright, fine. I'll help. Why not, I don't have anything better to do anyways."),
                ])),
                Branch(keys: ["end"], target: Steps([
                    Return,
                ])),
            ],
        ),
    },
    scenes: {},
)
