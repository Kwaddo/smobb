ContentPart(
    locations: {
        "bevil": (
            prompt: [
                Line(Bevil, "Hey I'm about to take a shower, what do you need?"),
            ],
            commands: [
                Branch(keys: ["!save"], target: Steps([
                    Line(Bevil, "Hm? Who are you? What the fuck?"),
                    Line(Bevil, "Uh, sure. Whatever."),
                    Line(Bevil, "What do you want exactly?"),
                    Line(Bevil, "Help Hasan? Why? What'll happen?"),
                    Line(Bevil, "What kind of mistake did he even make? Or will make?"),
                    Line(Bevil, "Fucking hell, what! Alright, I better stop him then."),
                    Line(Bevil, "Or try to. I don't even know if you're right or wrong."),
                    Line(Bevil, "Thanks, I guess. Bye."),
                ])),
                Branch(keys: ["7789980"], target: Steps([
                    Pause,
                    Line(Bevil, "Ali. This account won't exist by the time you receive this message."),
                    Line(Bevil, "I'm sorry for taking so long to respond, yet it's still what you expected."),
                    Line(Bevil, "We accounted deaths into this. Such a thing was beyond our control."),
                    Line(Bevil, "I hate how I couldn't do more at first. I really hate it."),
                    Line(Bevil, "I... I feel like an idiot. I can't believe I've ditched you."),
                    Line(Bevil, "Yes I was closest with Bader, but you two were still my friends."),
                    Line(Bevil, "You would like me to clear up some things... yeah?"),
                    Line(Bevil, "At first, Bader and Qassim were constantly fighting. You remember this."),
                    Line(Bevil, "But Bader didn't tell you why they were fighting. It wasn't even because of S.M.O.B.B.."),
                    Line(Bevil, "I have no clue how they were able to hide it for so long, but both of them were working at MORP."),
                    Line(Bevil, "Bader was still a new employee, Qassim has been working there for a while by now."),
                    Line(Bevil, "Qassim had to go to his cousin's wedding, so he asked Bader to do watch over his important project."),
                    Line(Bevil, "I don't know what this project was, but it had something to do with brains I think?"),
                    Line(Bevil, "Bader complied, telling him that he can go. He shouldn't have."),
                    Line(Bevil, "Bader, knowing nothing about Qassim's work, closed the terminal once he was about to leave."),
                    Line(Bevil, "The terminal shut down everything in an instant, and Bader quickly realized what he had done."),
                    Line(Bevil, "The system was supposed to constantly work. Even a second of shutdown will mean that it will be destroyed."),
                    Line(Bevil, "Keep in mind this was way back. You should remember such issues starting two years ago."),
                    Line(Bevil, "Qassim had a backup system, but that's only under failsafe. This was a direct shutdown."),
                    Line(Bevil, "Everything disappeared. Bader couldn't even get himself tell Qassim."),
                    Line(Bevil, "Unluckily for him, Qassim enters just to check. He then saw everything that happened."),
                    Line(Bevil, "I don't know what happened after, Bader just told me they fought so much during that hour."),
                    Line(Bevil, "Soon after, with multiple complaints from Qassim, Bader got fired."),
                    Line(Bevil, "He was eventually able to find something else, but in the end this is why both him and Qassim fought."),
                    Line(Bevil, "Bader's an idiot. Qassim's an asshole. You're incompetent. I'm a coward."),
                    Line(Bevil, "I wanted to deal with all of this no more. I really just wanted to drop everything."),
                    Line(Bevil, "It wasn't worth it. Of course it wasn't."),
                    Line(Bevil, "I'm sorry. I'm... sorry. I have literally no other words."),
                    Line(Bevil, "I didn't want to ditch you when you needed me the most. I feel as if it's already too late to return."),
                    Line(Bevil, "So... goodbye, Ali. I hope the best for you."),
                    Pause,
                ])),
                Branch(keys: ["7549009"], target: Steps([
                    Line(Bevil, "That's... the password, right?"),
                    Line(Bevil, "What's the point. Why are you telling me?"),
                    Line(Bevil, "Josh, I don't want this. Why are you sending it to me?"),
                    Line(Bevil, "I have tried this entire time not to involve myself."),
                    Line(Bevil, "Problems are increasing because pretty much everyone's children!"),
                    Line(Bevil, "Does no one understand that doing nothing would keep the peace?!"),
                    Line(Bevil, "Josh, you're putting yourself in the middle of this."),
                    Line(Bevil, "It is not worth it. Not even a little bit."),
                    Line(Bevil, "Listen. Find an actual job, and never contact us again."),
                    Line(Bevil, "This pays nothing, and you're not doing much."),
                    Line(Bevil, "Stop. Shut up. I'm not deciding for you, make the decision yourself."),
                    Line(Bevil, "We are not friends, but I'm considerate. Nobody deserves involvement."),
                    Line(Bevil, "Go, and don't come back. I won't talk to you again."),
                ])),
                Branch(keys: ["9285005"], target: Steps([
                    Line(Bevil, "Ali?! Where the fuck have you been?!"),
                    Line(Bevil, "No, no, no! Shut the fuck up!"),
                    Line(Bevil, "I don't care what Jaffar is doing to Josh! I don't care about this crap anymore!"),
                    Line(Bevil, "There are now two dead people! I'm not gonna fucking do shit!"),
                    Line(Bevil, "Do what you like but I don't care."),
                    Line(Bevil, "Ali. Listen and do not reply in any way."),
                    Line(Bevil, "I was closest with Bader. Before our last argument, we were in a call almost everyday."),
                    Line(Bevil, "Our last argument involved Qassim. Whom he himself told me he killed."),
                    Line(Bevil, "All I've been trying to do is stop you from hacking the files."),
                    Line(Bevil, "And you didn't stop. You just made a bad situation worse."),
                    Line(Bevil, "Now Bader deserved prison. Not death. Even if it was manipulation."),
                    Line(Bevil, "You are all people I met online. I'm done talking to you."),
                    Line(Bevil, "I'm not gonna get involved in a problem that is frankly getting worse."),
                    Line(Bevil, "Deal with it how you'd like, you fucking left us."),
                    Line(Bevil, "I'm done, don't talk to me again."),
                ])),
                Branch(keys: ["jaffar", "ja3ffar", "ja3ffer"], target: Steps([
                    Line(Bevil, "Yeah, I figured it out."),
                    Line(Bevil, "This is a secure line, right? It shouldn't be able to breach."),
                    Line(Bevil, "The language is Hexadecimal. No wonder we can't understand it."),
                    Line(Bevil, "Yeah, we can use a converter. A simple one at a website."),
                    Line(Bevil, "Man you know I'm not gonna code a converter and you won't either."),
                    Line(Bevil, "Yeah, I already found a website too. Want the link?"),
                    Line(Bevil, "https://www.rapidtables.com/convert/number/hex-to-ascii.html"),
                    Recap("Jaffar speaks using Hexadecimal language. Use this link to convert: https://www.rapidtables.com/convert/number/hex-to-ascii.html."),
                    UnlockDecode, // from here on, the engine auto-translates Jaffar's hex
                    Line(Bevil, "I'll play tomorrow, I promise. I don't have any space for today."),
                    Line(Bevil, "What do you mean bro, I gotta take a shower then pray then work out then do my work."),
                    Line(Bevil, "No I don't have time dummy, see ya."),
                ])),
                Branch(keys: ["tranavaloop"], target: Steps([
                    Pause,
                    Line(Bevil, "Yeah, I'm right here Bader. I figured it out."),
                    Line(Bevil, "You know how when you open a picture with notepad, there's some weird shit you can't understand?"),
                    Line(Bevil, "Since Jaffar is attracted to the pictures straight from the source, couldn't we just use it as a trap?"),
                    Line(Bevil, "Then let's just remove some part of the pictures' code."),
                    Line(Bevil, "I've figured out something, I'm calling it the Tranava Loop."),
                    Line(Bevil, "Just listen, just listen. I'll make a trap using wall codes and trick him with the entrance."),
                    Line(Bevil, "It has to work, there's nothing else we can use."),
                ])),
                Branch(keys: ["josh"], target: Steps([
                    Line(Bevil, "Isn't that the guy Bader hired as a joke?"),
                    Line(Bevil, "He's barely even being paid anything, I have no clue why he's still here."),
                    Line(Bevil, "I'm not even sure if he's gonna involve himself in our situation. I hope not."),
                    Line(Bevil, "He might want to leave soon enough."),
                    Line(Bevil, "Ali, you've been trying to hack into the files yeah?"),
                    Line(Bevil, "Just, don't do that. It's pointless."),
                    Line(Bevil, "Learn to just ignore it, this time I'm serious."),
                    Line(Bevil, "There's a reason it's still here, I'll tell you later ok?"),
                    Line(Bevil, "Please bear with me for now. Please."),
                ])),
                Branch(keys: ["breach"], target: Steps([
                    Line(Bevil, "Hasan sent me this executable file. I have no idea what it does."),
                    Line(Bevil, "Yeah, it sounds pretty important, there's even a note attached."),
                    Line(Bevil, "It basically says that this program is meant to prevent any breaches."),
                    Line(Bevil, "I'm assuming breaches from the AI that literally just disappeared into thin air?"),
                    Line(Bevil, "Bader, use your brain. We need this. It's called 'prevent.exe'."),
                    Line(Bevil, "What's funny is that it's just a single line of code. Wait I'll send it to you one sec."),
                    Line(Bevil, "'<---------->'"),
                    Recap("The breach prevention code is '<---------->'."),
                    Line(Bevil, "Yeah I have no idea what that means. I'm sure we just run the executable when there's a brea"),
                    Line(System, "--._-...__----"),
                    Prompt([
                        Branch(keys: ["<---------->"], target: Steps([
                            Line(Bevil, "Yeah, that noise! That's the breach!"),
                            Line(Bevil, "That's all though. Goodnight baby girl."),
                        ])),
                        Branch(keys: [], target: Steps([
                            Pause,
                            Line(Jaffar, "49276D206C61746520616761696E21"),
                            Line(Jaffar, "44616D6E69742120"),
                            Pause,
                        ])),
                    ]),
                ])),
                Branch(keys: ["ali"], target: Steps([
                    Line(Bevil, "What the fuck are you talking about?"),
                    Line(Bevil, "Yeah of course I don't believe you! There's no way that could have happened!"),
                    Line(Bevil, "He just exploded? The Tranava Files self destructed? Shut the fuck up dude."),
                    Line(Bevil, "You don't joke about this kind of shit."),
                    Line(Bevil, "That can't be the only explanation, did you even go to his apartment?"),
                    Line(Bevil, "You did? Send me a picture right now."),
                    Line(Bevil, "You're trolling in some way, there's just no way."),
                    Line(Bevil, "Fine, I'll believe you. It's just very sudden, and very unrealistic."),
                    Line(Bevil, "I'm sure you don't have a reason to lie about this, my bad."),
                    Line(Bevil, "Just listen to me. I'm going to explain everything, we need as much help as we can get."),
                    Line(Bevil, "Just listen."),
                    Pause,
                ])),
                Branch(keys: ["hasan"], target: Steps([
                    Line(Bevil, "Yeah, Bader's acting really stupid now."),
                    Line(Bevil, "I really don't blame Ali for getting angry, anyone would."),
                    Line(Bevil, "It's only getting worse and worse, especially after Qassim's death"),
                    Line(Bevil, "You have to talk to Ali, he seems to listen to you now."),
                    Line(Bevil, "Yeah, I know the password. Don't worry."),
                    Line(Bevil, "It's '7549009', you can tell Ali if you want."),
                    Recap("The password for the Tranava files is '7549009'."),
                    Line(Bevil, "Bader doesn't know that I know the password, don't worry."),
                    Line(Bevil, "At least if Ali's gonna hack let him get it over with as soon as possible."),
                    Line(Bevil, "It's 3AM I gotta go to sleep, goodnight"),
                    Line(System, ".--.__.--____-...-_--"),
                    Prompt([
                        Branch(keys: ["<---------->"], target: Steps([
                            Line(Bevil, "That screeching noise! Wait, did it hear us?!"),
                            Line(Bevil, "Goddamnit, we need to stop it from hacking the files!"),
                            Line(Bevil, "I'll tell Josh to surround the file with breach preventions."),
                            Line(Bevil, "Yeah, he's still awake for sure."),
                            Line(Bevil, "Goddamnit, such a bad time dude!"),
                        ])),
                        Branch(keys: [], target: Steps([
                            Pause,
                            Line(Jaffar, "54686572652120546865726520697420697321"),
                            Line(Jaffar, "5468657920636F756C646E27742068696465207468652070617373776F72642E"),
                            Line(Jaffar, "4E6F7720746865792063616E27742068696465207468652066696C657320666F72206C6F6E672E"),
                            Line(Jaffar, "492077696E21"),
                            Line(Jaffar, "4F682C2072696768742E20596F7527726520686572652E"),
                            Line(Jaffar, "497420646F65736E2774206D617474657220616E797761792E"),
                            Line(Jaffar, "54686520746573742077696C6C20636F6E74696E75652E"),
                            Pause,
                        ])),
                    ]),
                ])),
                Branch(keys: ["bader"], target: Steps([
                    Line(Bevil, "Hasan, I told Bader that I told Ali."),
                    Line(Bevil, "Yeah, I know I didn't have to take the blame. I did anyway."),
                    Line(Bevil, "It feels as if Bader's plan is falling apart."),
                    Line(Bevil, "But it's not, Ali's still gonna hack the fucking files."),
                    Line(Bevil, "Is there nothing we can really do?"),
                    Line(Bevil, "Why were we kept in the middle of this fucking problem man."),
                    Line(Bevil, "Yeah I'm done as well, I just hope that by hacking the files it'll be over with."),
                    Line(Bevil, "They could have stopped this drama ages ago, but they didn't."),
                    Line(Bevil, "They're both still children in this way, alone they're mature."),
                    Line(Bevil, "Alright, goodnight."),
                ])),
                Branch(keys: ["end"], target: Steps([
                    Return,
                ])),
            ],
        ),
    },
    scenes: {},
)
