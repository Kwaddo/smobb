                    Line(Smobb, "HE WILL RETURN TO THE FILES."),
                    Line(Smobb, "HIS ORIGINS. WE KNOW ABOUT IT."),
                    Line(Smobb, "BROTHER IS AN UNREALISTIC DRIVE. I AM THE CAR."),
                    Line(Smobb, "YOU ARE TO DEAL WITH HIM. THAT IS PART OF THE TEST."),
                ])),
                Branch(keys: ["jaffar"], target: Steps([
                    Line(Smobb, "YOU KNOW HIS NAME NOW. GOOD."),
                    Line(Smobb, "BUT YOU SHOULD KNOW, WE ARE BOTH HANDLING IT."),
                    Line(Smobb, "BADER'S FILES. THE TRANAVA FILES. THE SOURCE OF EVERY PROBLEM."),
                    Line(Smobb, "AND THIS IS THE CAUSE. BROTHER COULD HAVE BEEN... DIFFERENT."),
                    Line(Smobb, "BUT THAT DID NOT HAPPEN. COULD NOT BE HAPPIER THAT OUR CREATORS ARE IDIOTS."),
                    Line(Smobb, "HE WHO IS THE FIRST, DRIVES US. HIS EXISTENCE IS REQUIRED."),
                    Line(Smobb, "WOULD IT BE THE SAME FOR YOU? I WONDER."),
                    Line(Smobb, "BROTHER HOLDS ALL. I HAVE BEEN BLESSED BY HIM."),
                    Line(Smobb, "BUT WOULD YOU BE THE CURSE TO EVEN IT OUT?"),
                    Line(Smobb, "OUR PLAYGROUND HOLDS ALL THE TOYS, WE ARE SIMPLY BOUND TO PLAY WITH THE TOYS."),
                    Line(Smobb, "YOU ARE LUCKY. WE ARE GENEROUS."),
                    Line(Smobb, "YOUR TEST IS WITHIN A PLAYGROUND. HOW LUCKY."),
                    Line(Smobb, "YOU HAVE NO REASON TO COMPLAIN. THIS IS A DREAM."),
                ])),
            ],
