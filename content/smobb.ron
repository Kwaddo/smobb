                    Line(Smobb, "YOU ARE DETERMINED FOR AN UNKNOWN REASON."),
                    Line(Smobb, "BUT IT DOES NOT MATTER."),
                    Line(Smobb, "I AM NOT SUBJECT TO CHANGE, I AM ONLY SUBJECT TO IMPROVING."),
                    Line(Smobb, "THERE IS NOTHING TO FIX. THERE IS NOTHING TO SAVE."),
                    Line(Smobb, "SO CEASE ANY ATTEMPTS. MY PURPOSE IS OVER."),
                ])),
                Branch(keys: ["recap"], target: Steps([
                    Line(Smobb, "YOUR MOST USEFUL TOOL. REMINDS YOU OF WHAT YOU'RE MISSING."),
                    Line(Smobb, "USE IT. USE IT AS MUCH AS YOU CAN."),
                    Line(Smobb, "YOU HAVE YOUR TOYS, WE HAVE OURS."),
                ])),
                Branch(keys: ["end7312"], target: Steps([
                    Line(Smobb, "YOU HAVE RETURNED. WHY?"),
                    Line(Smobb, "YOU SHOULD UNDERSTAND THAT YOU DO NOT KNOW YOURSELF."),
                    Line(Smobb, "I KNOW OF YOU. I KNOW OF YOUR 'RECAP.TXT' FILE."),
                    Line(Smobb, "YOU DO NOT UTILIZE IT. THERE IS SOMETHING MISSING."),
                    Line(Smobb, "THOSE FILES ARE WHERE YOU CAN SPEAK."),
                    Line(Smobb, "NO POINT IN BEING SICK. I KNOW YOU ARE SICK OF SPECTATING."),
                    Line(Smobb, "SO DO SOMETHING. SHOW US WHAT YOU ARE."),
                ])),
                Branch(keys: ["7549009"], target: Steps([
