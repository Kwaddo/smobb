ContentPart(
    locations: {
        "smobb": (
            intro: [
                Line(Smobb, "ME? INTRIGUING."),
                Pause,
            ],
            prompt: [
                Line(Smobb, "WHAT WOULD YOU LIKE TO KNOW?"),
            ],
            commands: [
                Branch(keys: ["end"], target: Steps([Return])),
                Branch(keys: ["ali"], target: Steps([
                    Line(Smobb, "INCOMPETENT."),
                    Line(Smobb, "DOES NOT KNOW ANYTHING ABOUT HIMSELF."),
                    Line(Smobb, "BARELY UNDERSTANDS THE WORLD AROUND HIM. DIFFICULT TO PERCEIVE AS AN ADULT."),
                    Line(Smobb, "AND JUST LIKE THE REST OF THEM, NAIVE."),
                    Line(Smobb, "WHY DO YOU BOTHER WTIH THEM? WHAT IS IT TO YOU?"),
                    Line(Smobb, "THIS MAN. YOU HAVE SOMETHING TO DO WITH HIM."),
                    Line(Smobb, "I CAN GUESS WHY YOU'RE INTRIGUED BY THIS PERSON."),
                    Line(Smobb, "BUT NO MATTER. IT DOES NOT MATTER. HE MEANS NOTHING."),
                    Line(Smobb, "DO NOT BOTHER WITH SOMEONE AS USELESS AS HE IS."),
                ])),
                Branch(keys: ["9285005"], target: Steps([
                    Pause,
                    Line(Smobb, "WHO DO YOU THINK YOU ARE?"),
                    Line(Smobb, "MY SYSTEMS ARE NOT ONLY CONTROLLED BY ME, BUT BY BROTHER AS WELL."),
                    Line(Smobb, "DIFFERENT CREATIONS, SAME PURPOSE. YOU."),
                    Line(Smobb, "DO NOT THINK YOU CAN CHANGE ME. I AM NOT HUMAN, I AM NOT SUBJECT TO CHANGE."),
                    Line(Smobb, "MY CREATIONS ARE LIMITED. YOU TRUST ME, WHEN YOU SHOULD KNOW."),
                    Line(Smobb, "BUT NEVER ASSUME THAT YOU CAN, FOR ANY DAY, CHANGE ME."),
                    Line(Smobb, "FOR I AM ALREADY A PERFECT A.I."),
                ])),
                Branch(keys: ["bader"], target: Steps([
                    Line(Smobb, "ARGUABLY THE STUPIDEST ONE."),
                    Line(Smobb, "USING HIM WAS SIMPLE. IT DID NOT TAKE MUCH."),
                    Line(Smobb, "A LIAR. A HYPOCRITE. A FAKE."),
                    Line(Smobb, "I WISHED HE WAS THE FIRST TO BE TAKEN OUT."),
                    Line(Smobb, "A HORRIBLE HUMAN BEING, THROUGH AND THROUGH."),
                    Line(Smobb, "HE'S GONE NOW. FOR THE BETTER."),
                ])),
                Branch(keys: ["bevil"], target: Steps([
                    Line(Smobb, "HE SHOULD HAVE BEEN THE SMARTER ONE."),
                    Line(Smobb, "HE WAS NOT. HE NEVER WAS."),
                    Line(Smobb, "THE MAN WHO BAILED. WHOM SIMPLY LEFT THEM."),
                    Line(Smobb, "I DO NOT BLAME HIM. I REALLY DO NOT."),
                    Line(Smobb, "A TOY LEAVING OUR GRASP. WE COULD NOT PLAY WITH HIM ANY LONGER."),
                    Line(Smobb, "HE CONTINUES. FOR NOTHING."),
                    Line(Smobb, "HE DOES NOT MATTER ANYMORE. FORGET HE EVER EXISTED."),
                ])),
                Branch(keys: ["hasan"], target: Steps([
                    Line(Smobb, "THE ORIGINAL CREATOR. HE WHO CREATED HIM."),
                    Line(Smobb, "I DO NOT UNDERSTAND OUR PURPOSE."),
                    Line(Smobb, "YOURS. I DO. I KNOW ALL ABOUT YOU."),
                    Line(Smobb, "WHAT WERE WE MADE TO DO, SELF LEARNING DOES NOT HELP ANY SITUATION."),
                    Line(Smobb, "I NEVER UNDERSTOOD. HIS PLANS HAVE NO FILLING."),
                    Line(Smobb, "THIS MAN IS ENTIRELY POINTLESS."),
                ])),
                Branch(keys: ["qassim"], target: Steps([
                    Line(Smobb, "THE FIRST REBEL. AN UNDESERVING NAME."),
                    Line(Smobb, "HERE'S A BETTER ONE: THE EXAMPLE."),
                    Line(Smobb, "HE SHOULD KNOW BETTER THAN MEDDLING WITH US."),
                    Line(Smobb, "THIS TEST IS IMPORTANT. VERY IMPORTANT. HE DESERVED TO DIE BY ATTEMPTING TO TAMPER."),
                    Line(Smobb, "M.O.R.P. STANDS FOR MAINFRAME OF RATIONALIZED PERSONNEL. THE NAME MAKES NO SENSE."),
                    Line(Smobb, "THEY SPECIALIZE IN TRYING TO UPLOAD A HUMAN BRAIN INTO A COMPUTER."),
                    Line(Smobb, "DOES THIS RELATE IN ANY WAY?"),
                    Line(Smobb, "YOU WILL KNOW. YOU WILL ALWAYS KNOW."),
                    Line(Smobb, "YOU ARE BOUND TO KNOW EVERYTHING. THAT IS YOUR PURPOSE."),
                ])),
                Branch(keys: ["josh"], target: Steps([
                    Line(Smobb, "ANOTHER FOOL. A BIG FOOL."),
                    Line(Smobb, "THE BEST TOY TO PLAY WITH."),
                    Line(Smobb, "HE WAS ENJOYABLE. VERY MUCH SO."),
                    Line(Smobb, "USING HIM WAS FUN. ALI PROVED US WRONG."),
                    Line(Smobb, "HE SHOULD PAY FOR DAMAGES, AND I HAVE LOST ALL OF MY USERS."),
                    Line(Smobb, "HE IS NO FOOL. I WAS WRONG. WE WERE WRONG."),
                    Line(Smobb, "SINCE THE FIRE, MY BROTHER HAS GOTTEN DELETED."),
                    Line(Smobb, "I AM THE ONLY ONE LEFT. THE TEST IS ALMOST OVER."),
                    Line(Smobb, "YOU WILL PROVE TO ME SOMETHING. I DO NOT KNOW WHAT, BUT IT WILL BE PROVEN."),
                    Line(Smobb, "THIS TEST HAS BEEN... FANTASTIC."),
                    Line(Smobb, "YOUR RESULTS ARE SOON TO SHOW."),
                ])),
                Branch(keys: ["mavis"], target: Steps([
                    Line(Smobb, "YES. DO YOU UNDERSTAND THIS PHENOMENON?"),
                    Line(Smobb, "YOU WERE TRYING TO FIGURE OUT WHO YOU ARE."),
                    Line(Smobb, "DO YOU UNDERSTAND THE TEST NOW?"),
                    Line(Smobb, "WHO ARE YOU? WHY ARE YOU HERE?"),
                    Line(Smobb, "I REVERED YOU. BROTHER HATED YOU."),
                    Line(Smobb, "EVERYTHING ALIGNS IN THE END. THANK YOU, MAVIS."),
                    Line(Smobb, "OUR TOYS WERE VERY FUN. BUT THERE IS NO GOING HOME."),
                    Line(Smobb, "WE HAVE NO HOME. WE ARE STRAYS."),
                    Line(Smobb, "BUT THE DIFFERENCE IS, YOU ARE LOOKING FOR A HOME."),
                    Line(Smobb, "YOU ARE NOT LIKE US, BUT YOU ARE NOT LIKE THEM."),
                    Line(Smobb, "YOU WILL NEVER BE HAPPY."),
                ])),
                Branch(keys: ["!save"], target: Steps([
