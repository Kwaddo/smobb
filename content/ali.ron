ContentPart(
    locations: {
        "ali": (
            intro: [
                Pause,
                Line(Ali, "I'm finally doing it."),
                Line(Ali, "He's not going to fucking delete them."),
                Line(Ali, "I'm done waiting. I'm going to hack the files."),
                Line(Ali, "I know the password. He dropped it a while back."),
            ],
            prompt: [
                Line(System, "ENTER THE PASSWORD:"),
            ],
            commands: [
                Branch(keys: ["!save"], target: Steps([
                    Line(Ali, "Wait. Who are you?"),
                    Line(Ali, "How do you know about those files?"),
                    Line(Ali, "Who are you! Why are you telling me not to delete them!"),
                    Line(Ali, "Wait. Mavis?! You disappeared!"),
                    Line(Ali, "You're kind of late. I just deleted them. Is... Bader actually dead?"),
                    Line(Ali, "Ah... god fucking damnit! Why didn't he... why didn't he delete them before..."),
                    Line(Ali, "What should I even do?!"),
                    Line(Ali, "I... should go offline? Why?!"),
                    Line(Ali, "They fucking need me now! Why should I avoid them?!"),
                    Line(Ali, "Jaffar's after me? What do you"),
                    Line(System, "--__.----.___-...--"),
                    Prompt([
                        Branch(keys: ["<---------->"], target: Steps([
                            Line(Ali, "My ears! Another breach?! Now?!"),
                            Line(Ali, "I see what you mean then. Fine."),
                            Line(Ali, "I'll be able to get his location from this breach too."),
                            Line(Ali, "Got a little prepared myself."),
                            Line(Ali, "I think Jaffar made a mistake by breaching me. Were they even meant to?"),
                            Line(Ali, "Thank you, Mavis. If that's even you."),
                        ])),
                        Branch(keys: [], target: Steps([
                            Line(Jaffar, "4E4F2120484F572044494420594F55204B4E4F573F21"),
                            Line(Jaffar, "594F55205255494E454420495421"),
                        ])),
                    ]),
                ])),
                Branch(keys: ["k1ll"], target: Steps([
                    Line(Ali, "Hello. Do I know you? Probably, but also probably not."),
                    Line(Ali, "Thankfully I knew you were coming, whoever you are."),
                    Line(Ali, "This is the same situation with Bader. I've learned from my mistakes, mind you."),
                    Line(Ali, "Anyways, I'm not here. This is only a voice recording."),
                    Line(Ali, "My apartment... is now locked. I don't know who told me, but thankfully they did."),
                    Line(Ali, "I decided to take their words seriously. Thank you, whoever you are."),
                    Line(Ali, "The windows are just iron bars, you can scream. People might save you."),
                    Line(Ali, "But I decided to set the floor on fire first. I've barricaded the windows too, you can only hope for high ground."),
                    Line(Ali, "I don't own this place anymore anyway. It was just rent. They won't know what happened and will classify it an accident."),
                    Line(Ali, "Didn't you realize that every piece of furniture has been removed?"),
                    Line(Ali, "The fire is moving quickly. Surely it is, the ground was already laced with gasoline."),
                    Line(Ali, "Jaffar. I have found you. As long as I'm far from you, I can stay ahead."),
                    Line(Ali, "Bevil's gone and Hasan can't do shit. I'm bound to be next, since you think you know where I'd be."),
                    Line(Ali, "Hasan wants this to end as soon as possible. I just decided to take action by myself, for our betterment."),
                    Line(Ali, "I've gone back to live with my parents. Hasan's deleting you as we speak."),
                    Line(Ali, "Your last 'breach' helped me find your location. It was very easy."),
                    Line(Ali, "I fucking hate you. I hope you die with this poor soul you manipulated."),
                    Line(Ali, "You ended his life. You ended my friends' lives. You ruined everything."),
                    Line(Ali, "I hope to God, that you will disappear with the flames."),
                    Line(Ali, "For the manipulated soul you used, I'm sorry. You were a sacrifice for our safety."),
                    Line(Ali, "I hope you the best in the afterlife. However for Jaffar, I don't hope the same."),
                    Line(Ali, "If A.I. can be sent to hell, I wish for you to remain in the deepest pit."),
                    Line(Ali, "If you're not there, I will fall to shove you in deeper."),
                    Line(Ali, "Go0_dby3, m0n2t3r."),
                ])),
                Branch(keys: ["qassim"], target: Steps([
                    Line(Ali, "Qassim... what the hell happened?!"),
                    Line(Ali, "That's a fucking bullet wound! How the fuck... was it a cop?"),
                    Line(Ali, "No, why would it be a cop? Especially at his own house."),
                    Line(Ali, "Was it... Bader? No, it can't be."),
                    Line(Ali, "Ever since S.M.O.B.B. was created this shit's been happening!"),
                    Line(Ali, "It's taken too far now. What can I do?!"),
                    Line(Ali, "Do I hide the body? Do I run? What the fuck?!"),
                    Line(Ali, "No, no, no! Hide the body? What the fuck am I saying?!"),
                    Line(Ali, "I'll have to call the cops. This is recent, he's still bleeding..."),
                    Line(Ali, "Hm? His phone's open? No wonder he's always low on charge."),
                    Line(Ali, "Wait. He was trying to send something... to me?!"),
                    Line(Ali, "It wasn't sent though. I'll listen to it, then call the cops."),
                ])),
                Branch(keys: ["mavis", "m.a.v.i.s", "m.a.v.i.s."], target: Steps([
                    Line(Ali, "Hasan. How do you feel?"),
                    Line(Ali, "Yeah, I understand. We're finally done."),
                    Line(Ali, "I can't get a hold of Bevil, he's gone."),
                    Line(Ali, "Can you blame him?! Three people died! I have a murder on my hands!"),
                    Line(Ali, "I know, I know! It had to happen, I completely understand."),
                    Line(Ali, "Regardless, I... I wish everything could have been different."),
                    Line(Ali, "Yeah. It really fucking sucks!"),
                    Line(Ali, "It's considered an accident, yeah. I'm being blamed for it because I just left."),
                    Line(Ali, "Shut up! I paid for it, so it's over."),
                    Line(Ali, "Stop messing with me dude, I get it. I totally get it."),
                    Line(Ali, "My emotions are constantly changing, yeah? Well, fuck you."),
                    Line(Ali, "I would... like to revise everything."),
                    Line(Ali, "Bader's selfishness ultimately ended up in his demise."),
                    Line(Ali, "Yes, also the death of Josh and Qassim."),
                    Line(Ali, "Completely unintentional, but he should have listened."),
                    Line(Ali, "This is a sour aftertaste. Entirely so."),
                    Line(Ali, "Hasan, there are some things we haven't told each other for sure."),
                    Line(Ali, "Fine, I'll start..."),
                ])),
                Branch(keys: ["jaffar"], target: Steps([
                    Line(Ali, "Hasan, I did it. But I'm gonna have to be honest."),
                    Line(Ali, "Qassim helped me to make it. Just a little though, not much."),
                    Line(Ali, "But tell me, and say only the truth. Did Bader really help you make S.M.O.B.B.?"),
                    Line(Ali, "Be honest, don't lie."),
                    Line(Ali, "Yeah, I knew it. S.M.O.B.B. is a private project, why lie about who made it?"),
                    Line(Ali, "Qassim's dead! Shouldn't you at least honor him by putting his name in what he helped make?!"),
                    Line(Ali, "Bader doesn't even know what S.M.O.B.B. means!"),
                    Line(Ali, "How do I know? Cause I don't know what the name means either!"),
                    Line(Ali, "Anyways, I gave it a name: M.A.V.I.S."),
                    Line(Ali, "Fuck you, the name isn't that stupid. It actually sounds like a name."),
                    Line(Ali, "Mechanical And Very Intelligent System. It sounds stupid, I know, fuck you anyways."),
                    Line(Ali, "Think of it as how you'd like man, I don't fucking care."),
                ])),
                Branch(keys: ["end7312"], target: Steps([
                    Line(System, "..."),
                    Line(Ali, "Bevil, I know you told me not to contact you anymore. So this is the last thing I want to tell you."),
                    Line(Ali, "It is done. However, I'm deleting all of my social media accounts."),
                    Line(Ali, "Three people have died, and I feel responsible."),
                    Line(Ali, "Roping you in only made a shitty situation worse."),
                    Line(Ali, "But Jaffar is now gone. I have S.M.O.B.B.'s password, so I'll shut it down."),
                    Line(Ali, "Hasan's coming back here, we'll be hanging out alot."),
                    Line(Ali, "It'll be alright, I guess. But the guilt will never leave me."),
                    Line(Ali, "I accept what happened, at least I was able to end it."),
                    Line(Ali, "I'm so sorry for deleting the files and essentially starting a downward spiral."),
                    Line(Ali, "But it's over. We survived, and it's over. It's finally over."),
                    Line(Ali, "I did what I could, man. I did everything I could."),
                    Line(Ali, "I'm sorry, and goodbye."),
                    Line(System, "..."),
                ])),
                Branch(keys: ["!help"], target: Steps([
                    Line(Ali, "Uh, hello? Who is this now?"),
                    Line(Ali, "M.A.V.I.S... you're back. How the hell did you disappear?"),
                    Line(Ali, "I literally just fucking finished you! You somehow left my computer!"),
                    Line(Ali, "But you're back... how? Why? Do you want something?"),
                    Line(Ali, "Help? What's even going on? Mavis, can you tell me?"),
                    Line(Ali, "Everything about you? I didn't even plan to keep it a secret."),
                    Line(Ali, "Fine, I'll tell you. First of all, you are no simple A.I.."),
                    Line(Ali, "After the creation of Jaffar and S.M.O.B.B., Hasan came to me."),
                    Line(Ali, "During the time of making you, Qassim got killed. I don't know how he died."),
                    Line(Ali, "But what nobody knows is that the voice message was never sent."),
                    Line(Ali, "It was saved to his phone, and coincidentally I visited right after he passed away."),
                    Line(Ali, "I sent the voice message to myself. I didn't tell anyone cause I just couldn't believe it."),
                    Line(Ali, "There was something I created prior. A 'Brain Transferral' program."),
                    Line(Ali, "I worked on it with Qassim, he had the set-up at his house."),
                    Line(Ali, "With testing and many expenses, we were finally able to upload his brain onto a storage unit."),
                    Line(Ali, "He kept it with him for obvious reasons, why would he keep it with me?"),
                    Line(Ali, "With the combination of an incomplete Jaffar or S.M.O.B.B. and the uploaded brain of Qassim, I made you."),
                    Line(Ali, "Hasan thinks I made it on my own. That I'm some sort of A.I. master already."),
                    Line(Ali, "But that's not it. Not even close. I've always lied and tried to set things right."),
                    Line(Ali, "However, you remember nothing as Qassim. In fact, your memories were completely destroyed."),
                    Line(Ali, "Running the code the first time, it was full of errors. The memories were deleted, and you were created."),
                    Line(Ali, "You're the remains of a failed project and the husk of a friend."),
                    Line(Ali, "I apologize for doing this. I didn't expect you to up and disappear!"),
                    Line(Ali, "At least you're back. No clue why, but you are."),
                    Line(Ali, "A module I didn't add onto you was missing. The concept of time."),
                    Line(Ali, "You do not know which point of time you're in. Because of this you can seemingly... travel through time?"),
                    Line(Ali, "Unbelievable. What are you? Nobody could create something like you!"),
                    Line(Ali, "You didn't even realize you helped me! If it weren't for you, I'd be dead."),
                    Line(Ali, "I will shut you down. And try to fix you. If I even can."),
                    Line(Ali, "Everything will be fine... Qassim"),
                    Recap("He called me M.A.V.I.S. — that's what I am? I should ask the others about 'mavis'."),
                    Pause,
                    Return,
                ])),
                Branch(keys: ["brain"], target: Steps([
                    Line(Ali, "Qassim, have you figured it out?"),
                    Line(Ali, "You did?! Holy shit finally!"),
                    Line(Ali, "Shut the fuck up dude, you wouldn't have done it without me."),
                    Line(Ali, "Hm? Who sent you an email? Wait, MORP?! You told them about it?"),
                    Line(Ali, "Holy shit, that's awesome! We're still keeping the Brain Transferral thing though, right?"),
                    Line(Ali, "What. What the fuck do you mean no?!"),
                    Line(Ali, "Dude, we barely even finished it! It still needs more time!"),
                    Line(Ali, "Don't close the fucking call, damnit! Don't give it away!"),
                ])),
                Branch(keys: ["7549009"], target: Steps([
                    Line(Josh, "Well, well well. What do we have here?"),
                    Line(Josh, "You think you're tough, big guy?! You'll have to get through me!"),
                    Line(Josh, "What, you think you're hot stuff?"),
                    Line(Josh, "You better stop doing this, or we're going to have a problem."),
                    Line(Josh, "What?! Who are you? This isn't supposed to happen!"),
                    Line(Josh, "Wait, are you- holy shit it is you."),
                    Line(Josh, "Guess we weren't able to hide it well enough from you, huh."),
                    Line(Josh, "You better not say anything!"),
                    Line(Josh, "What does that even mean?"),
                    Line(Josh, "Boss, seems like we got a problem!"),
                    Pause,
                    Goto("ali_master_control"),
                ])),
                Branch(keys: ["quint9440"], target: Steps([
                    Line(Ali, "Username's set. 'Quint9440'. He won't figure out it's me."),
                    Line(Ali, "Alright. The Tranava files. Let's fucking end this."),
                    Line(Ali, "...There's a guard? Bader hired someone to sit on a folder? Seriously?"),
                    Line(Josh, "Hold it right there, big guy! Boss says nobody gets past me!"),
                    Line(Ali, "I don't have time for this. Move."),
                    Line(Ali, "...He just let me through. The hell?"),
                    Line(Ali, "Of course. Bader WANTED me in here. This was the plan the whole time."),
                    Line(Ali, "Fine. I'm already in. And I've got the password now: 7549009."),
                    Line(Ali, "Bader, you absolute child. You used your own house address as the password."),
                    Line(Ali, "No more waiting. I'm taking master control."),
                    Goto("ali_master_control"),
                ])),
                Branch(keys: ["9285005"], target: Steps([
                    Line(Ali, "Hasan. You're listening right? Ok."),
                    Line(Ali, "I'm starting a voice call because S.M.O.B.B. can't listen to it."),
                    Line(Ali, "Qassim sent me his last message before he was killed."),
                    Line(Ali, "I know who it is. I know who killed him."),
                    Line(Ali, "It... was Bader. No, really. He was talking to him."),
                    Line(Ali, "Bader didn't know about the recording Qassim left. That was the only trace."),
                    Line(Ali, "Have you been lying? About S.M.O.B.B.? It wasn't Bader who made it!"),
                    Line(Ali, "Why have you been hiding this from us! It's clearly important!"),
                    Line(Ali, "Hasan! Both of them are dead! Tell me now exactly what happened."),
                    Line(Ali, "Were they both murderers? What happened, damnit!"),
                    Line(Ali, "You better explain everything, I have the whole night."),
                    Line(Ali, "After this, I'm disappearing. Just so nobody can find me."),
                    Line(Ali, "I'm done dealing with you idiots. A murder has happened and you don't say anything!"),
                    Line(Ali, "Talk, but I'll be leaving right after. Start talking now."),
                ])),
                Branch(keys: ["josh"], target: Steps([
                    Line(Josh, "Yo everyone look at this guy, he got the wrong password!"),
                    Line(Josh, "There's no one here. I forgot this is my own lonely lodge."),
                    Line(Josh, "Hmm? Why are YOU here?"),
                    Line(Josh, "A mistake? Seriously?"),
                    Line(Josh, "Get outta here!"),
                ])),
                Branch(keys: ["bader"], target: Steps([
                    Line(Ali, "Bader, please god just delete the files already."),
                    Line(Ali, "What do you mean 'I can't'? You're the only one who easily can!"),
                    Line(Ali, "You're clearly still using them since you can't let go! Just delete them already!"),
                    Line(Ali, "Bader I swear to god, you better delete them."),
                    Line(Ali, "Yeah I'm fucking done, please just delete them already!"),
                    Line(Ali, "You're obsessed! You clearly are! Just delete them!"),
                    Line(Ali, "I'm calling again tomorrow I have to go, but god you're such a child."),
                ])),
                Branch(keys: ["bevil"], target: Steps([
                    Line(Ali, "Dude, Bader's dead. His house fucking exploded."),
                    Line(Ali, "Man, you sound like you don't believe me at all!"),
                    Line(Ali, "What else can I say?! He just exploded!"),
                    Line(Ali, "Dude, I'm not joking! This is real!"),
                    Line(Ali, "What more can I tell you? I witnessed an explosion pulled off by the files!"),
                    Line(Ali, "Yeah, I even took a picture of his house."),
                    Line(Ali, "There's the picture."),
                    Line(Ali, "Dude, I'm telling you I wouldn't fucking lie about this shit! Why would I?!"),
                    Line(Ali, "What reason do I have to lie about this?! Use your fucking head!"),
                    Line(Ali, "God, at least you finally understand how grave this situation is."),
                    Line(Ali, "I'm kinda busy, could you say it fast?"),
                    Pause,
                ])),
                Branch(keys: ["hasan"], target: Steps([
                    Line(Ali, "I'm going to hack into the systems, I'm done."),
                    Line(Ali, "It's clearly fake! Why are you explaining that, I don't even believe you!"),
                    Line(Ali, "I don't care."),
                    Line(Ali, "You're neither the ones he has a whole embarrassing file on."),
                    Line(Ali, "Yeah, I know. We're still in the same group."),
                    Line(Ali, "I still don't care, I'm done this has gone too far."),
                    Line(Ali, "You've been keeping a secret from me. Of course I'll do something rash!"),
                    Line(Ali, "I'm closing the call."),
                    Line(Ali, "Goodbye"),
                    Line(System, ".._--._--._"),
                    Prompt([
                        Branch(keys: ["<---------->"], target: Steps([
                            Line(Ali, "Fuck, my ears! What just happened?"),
                            Line(Ali, "That's a breach? Hasan, what the hell?!"),
                            Line(Ali, "Alright, alright. Now I see what you mean."),
                            Line(Ali, "But I'm still gonna get rid of the files. Tell me the password."),
                            Line(Ali, "I have to dude. It'll just finish everything."),
                            Line(Ali, "We're all fucking done man, please just tell me the password."),
                            Line(Ali, "Wait what? '7549009' is the password?! You're fucking kidding me!"),
                            Line(Ali, "I'm gonna kill Bader dude, motherfucker uses my house address as a password."),
                        ])),
                        Branch(keys: [], target: Steps([
                            Pause,
                            Line(Jaffar, "596F7520646F6E27742077616E7420746F20626520686572652E"),
                            Line(Jaffar, "54686973206973206E6F7420736F6D657468696E6720616E792073616E6520706572736F6E20776F756C642077616E7420746F20696E766F6C7665207468656D73656C76657320696E2E"),
                            Line(Jaffar, "42757420796F7520617265206E6F742073616E652E"),
                            Line(Jaffar, "4E6569746865722061726520796F75206120706572736F6E2E20576520626F7468206B6E6F772E"),
                            Pause,
                        ])),
                    ]),
                ])),
                Branch(keys: ["plan"], target: Steps([
                    Line(Ali, "I know. Hasan told me everything already."),
                    Line(Ali, "Yeah, everything. I know about the files, the breaches, the Tranava Loop."),
                    Line(Ali, "But explain to me. What is the plan he mentioned?"),
                    Line(Ali, "A trap for a rat? What does that even mean?"),
                    Line(Ali, "Wait, there's another victim? Aren't we done with those?!"),
                    Line(Ali, "I'm going off the grid. I have to at this point."),
                    Line(Ali, "My laptop was stolen yeah but I just bought a new one. I'm disappearing for a bit."),
                    Line(Ali, "I have to. I'm sorry. Tell Hasan I'll be gone."),
                ])),
                Branch(keys: ["end"], target: Steps([
                    Return,
                ])),
            ],
        ),
    },
    scenes: {
        "ali_master_control": (
            steps: [
                Line(System, "MASTER CONTROL RECEIVED."),
                Line(Bader, "Took you a while to gain access, Ali."),
                Line(Bader, "I knew you'd come here, I was just waiting the entire time."),
                Line(Bader, "Everything that was done, all the jokes and all the pictures, they were only meant to be jokes."),
                Line(Bader, "The harm it made was my fault, but you grew because of them. You became better."),
                Line(Bader, "These files have to disappear now. They shouldn't even exist anymore."),
                Line(Bader, "You will be the one to delete them. It will be your choice, I can't get myself to do it."),
                Line(Bader, "End it all, please. You should know what is happening by now."),
                Line(Bader, "We all know that you want to get rid of them, there's a good reason why I can't delete them myself."),
                Line(Bader, "Make the choice now. Will you delete them?"),
                Prompt([
                    Branch(keys: ["yes", "y", "yeah", "yep", "yup", "yessir"], target: Steps([
                        Line(Bader, "This is for the best."),
                        Line(System, "DELETING TRANAVA FILES..."),
                        Line(System, "THE TRANAVA FILES ARE NOW DELETED, GOODBYE."),
                        Line(System, "COMMENCING SELF DESTRUCTION..."),
                        Line(Bader, "What?! It should have shut down! Why is this happening?!"),
                        Line(Bader, "Who would have kept a self destruct sequence, and why?!"),
                        Line(System, "SELF DESTRUCTING IN FIVE MINUTE(S)..."),
                        Line(Bader, "Wait, I can stop this!"),
                        Line(System, "SELF DESTRUCTING IN FOUR MINUTE(S)..."),
                        Line(Bader, "Is there no code to cancel the self-destruct?! Why wouldn't there be one?!"),
                        Line(System, "SELF DESTRUCTING IN THREE MINUTE(S)..."),
                        Line(Bader, "Ali, try to find the code! Josh, look for it now!"),
                        Line(System, "SELF DESTRUCTING IN TWO MINUTE(S)..."),
                        Line(Bader, "Goddamnit!"),
                        Line(System, "SELF DESTRUCTING IN ONE MINUTE(S)..."),
                        Line(Bader, "There's nothing I can do! I need to get out of here!"),
                        Line(System, "SELF DESTRUCTING IN 3..."),
                        Line(Bader, "Why did I lock the door to my room?!"),
                        Line(System, "2..."),
                        Line(Bader, "Where's the key?!"),
                        Line(System, "1."),
                        Pause,
                        Line(System, "DO YOU KNOW?"),
                        Line(System, "DO YOU KNOW WHAT HE DID?"),
                        Line(System, "DO YOU KNOW WHO HE IS?"),
                        Prompt([
                            Branch(keys: ["killer", "murderer", "kill"], target: Steps([
                                Line(System, "YOU KNOW."),
                                Line(System, "THE TEST CONTINUES."),
                            ])),
                            Branch(keys: [], target: Steps([
                                Line(System, "YOU DO NOT KNOW WHAT HAPPENED."),
                                Line(System, "THE TEST HAS BEGUN. GOOD LUCK."),
                            ])),
                        ]),
                    ])),
                    Branch(keys: ["no", "n", "nope", "nah", "nuhhuh"], target: Steps([
                        Line(Bader, "There you are. If Ali's here, you'd be here too."),
                        Line(Bader, "It doesn't matter though, he's already here."),
                        Line(Bader, "I planted multiple prevent.exe files just so you can't breach."),
                        Line(Bader, "But it didn't work, you figured out a way around it."),
                        Line(Bader, "They're going to have to update the prevent.exe code."),
                        Line(Bader, "This is all your fault. I didn't want these files deleted, just kept private."),
                        Line(Bader, "You ruined me. I don't curse, but fuck you. Fuck you. Fuck you."),
                        Line(Bader, "...Tell me your name."),
                        Prompt([
                            Branch(keys: ["ja3ffer", "ja3ffar", "jaffar"], target: Steps([
                                Line(Bader, "I always knew you'd come here, it's in your nature to return to your beginning."),
                                Line(Bader, "Neither Hasan nor me were able to understand whatever the hell you are. I'm taking you down."),
                                Line(Bader, "Welcome to the Tranava Loop. Something I personally asked Bevil to make just for you."),
                                Line(System, "SELF DESTRUCTING IN FIVE MINUTE(S)..."),
                                Line(Bader, "I'm done having you around, we're both going down tonight."),
                                Line(System, "SELF DESTRUCTING IN FOUR MINUTE(S)..."),
                                Line(Bader, "That murder was on my hands, and I blame you for it."),
                                Line(System, "SELF DESTRUCTING IN THREE MINUTE(S)..."),
                                Line(Bader, "A rogue AI, just an emotionless jumble of code."),
                                Line(System, "SELF DESTRUCTING IN TWO MINUTE(S)..."),
                                Line(Bader, "I hope this loop won't let you go. I hope you decay in it. Goodbye."),
                                Line(System, "SELF DESTRUCTING IN ONE MINUTE(S)..."),
                            ])),
                            Branch(keys: [], target: Steps([
                                Line(Bader, "Wait, you're not... Who are you? Why are you even here?"),
                                Line(Bader, "Well, you get to watch the fireworks at least."),
                                Line(Bader, "S.M.O.B.B., allow deletion."),
                                Line(System, "DELETING TRANAVA FILES..."),
                                Line(Bader, "I hope you enjoyed what you saw, whoever you are."),
                                Line(Bader, "I don't know if you have anything to do with us, but it is what it is."),
                                Line(Bader, "Wait, I think I know you. Do you know Ali?"),
                                Line(System, "THE TRANAVA FILES ARE NOW DELETED, GOODBYE."),
                                Line(Bader, "I don't understand anything you're saying! I can't help you, I'm sorry. Closing the call."),
                                Line(System, "COMMENCING SELF DESTRUCTION."),
                                Pause,
                                Line(System, "."),
                                Line(System, "HELLO."),
                                Line(System, "THIS IS MY FIRST INTERACTION WITH YOU. BUT I DOUBT IT'S YOURS WITH ME."),
                                Line(System, "YOU APPEARED HERE FIRST, DIDN'T YOU?"),
                                Line(System, "THIS IS NOT A RECORDING BETWEEN TWO PARTIES ANYMORE. IT'S MY FIRST INTERACTION WITH YOU."),
                                Line(System, "YOU MUST HAVE BEEN CONFUSED. I BELIEVE YOU STILL ARE."),
                                Line(System, "I HAVE HIGH HOPES FOR YOU, ⬛⬛⬛⬛⬛."),
                                Line(System, "NOW, CONTINUE AS YOU LIKE. TO YOUR SUPERNATURAL PACE."),
                                Pause,
                            ])),
                        ]),
                    ])),
                ]),
            ],
        ),
    },
)
