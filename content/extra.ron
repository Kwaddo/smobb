ContentPart(
    locations: {
        "extra": (
            prompt: [
                Line(System, "WHAT WOULD YOU LIKE TO SEARCH FOR?"),
                Line(System, "OPTIONS ARE: STORIES/END."),
            ],
            commands: [
                Branch(keys: ["story", "stories"], target: Steps([
                    Line(System, "THERE ARE 12 STORIES, WHICH ONE WOULD YOU LIKE TO LISTEN TO?"),
                    Line(System, "(USE A NUMERICAL VALUE)"),
                    Prompt([
                        Branch(keys: ["1"], target: Steps([
                            Pause,
                            Line(System, "THERE WERE TWO MEN. THEY CONSIDERED EACH OTHER AS FRIENDS."),
                            Line(System, "THEY WOULD ALWAYS TALK TO EACH OTHER, THERE IS ALWAYS SOMETHING TO TALK ABOUT."),
                            Line(System, "HOWEVER, FREQUENTLY THEY WOULD GET ANNOYED WITH ONE ANOTHER."),
                            Line(System, "AS CLOSE AS THEY WERE, THEY WOULD ALWAYS FIGHT."),
                            Line(System, "CONSTANT DISAGREEMENT. NOTHING WOULD CHANGE."),
                            Line(System, "BUT THEY NEVER ONCE REGRETTED SPENDING THEIR TIME WITH ONE ANOTHER."),
                            Line(System, "BOTH WOULD TAKE THEIR JOKES TOO FAR, BOTH WOULD MAKE HUGE MISTAKES."),
                            Line(System, "ANY NORMAL PERSON WOULD HAVE STOPPED CONTACT WITH EITHER. THESE MEN WERE NOT NORMAL."),
                            Line(System, "ONE DAY, THERE WAS A HUGE ARGUMENT BETWEEN BOTH MEN."),
                            Line(System, "ARGUMENT WAS INTENSE. ENDED UP WITH MAN 2 DISAPPEARING. MAN 1 THOUGHT NOTHING OF IT."),
                            Line(System, "LATER THAT NIGHT, MAN 1 CAME TO REALIZE HIS MISTAKE. AND WISHED TO TALK TO MAN 2 AGAIN."),
                            Line(System, "HOWEVER, IT WAS TOO LATE. MAN 2 HAS DISAPPEARED ALREADY."),
                            Line(System, "HE TRIED CONTACTING HIM. HE TRIED GOING TO HIS HOUSE. HE TRIED EVERYTHING."),
                            Line(System, "MAN 2 HAD SIMPLY DISAPPEARED. THIS GREATLY SADDENED MAN 1."),
                            Line(System, "HE TRIED CONSTANTLY TO ACT AS IF IT WAS FINE. AS IF IT WAS NO BIG DEAL."),
                            Line(System, "MANY TIMES HE WOULD BLAME MAN 2 FOR THEIR ARGUMENTS, EVEN GOING AS FAR AS SAYING 'GOOD RIDDANCE'."),
                            Line(System, "BUT HE DOES NOT MEAN A SINGLE WORD HE CLAIMS, AND HE KNOWS THAT HIMSELF MORE THAN ANYONE."),
                            Line(System, "A MONTH AFTER THE DISAPPEARANCE OF MAN 2, MAN 1 CRIED. HE CRIED ALONE."),
                            Line(System, "HIS CLOSEST FRIEND IS NOW GONE. HE IS GONE."),
                            Line(System, "THREE MONTHS AFTER THE DISAPPEARANCE OF MAN 2, MAN 1 IS SLOWLY LOSING THE PEOPLE AROUND HIM."),
                            Line(System, "HE IS UNABLE TO MOVE ON. UNABLE TO MAKE NEW FRIENDS."),
                            Line(System, "MAN 1 KNOWS THAT MAN 2 WRONGED HIM MANY TIMES, BUT HE DID THE SAME TO HIM AS WELL."),
                            Line(System, "MAN 1 CRIES FOR HIS MISTAKES, AND HOPES TO SEE HIS FRIEND AGAIN."),
                            Line(System, "DESPITE HURTING EACH OTHER FREQUENTLY, THEY KNEW EACH OTHER BEST AND REMAINED FRIENDS."),
                            Line(System, "THIS IS MAN 1'S REGRET. AND IT ONLY BROUGHT HIS DOWNFALL."),
                            Pause,
                        ])),
                        Branch(keys: ["2"], target: Steps([
                            Pause,
                            Line(System, "ONCE, THERE WAS A MAN. THIS MAN DID NOT KNOW HIS OWN NAME."),
                            Line(System, "HE LIVED KNOWING THE NAME OF OTHERS, BUT NEVER HIS OWN."),
                            Line(System, "HE LAUGHED, BUT NEVER SMILED. HE CRIED, BUT NEVER FROWNED."),
                            Line(System, "THERE WAS NO IN-BETWEEN FOR THIS MAN. HE LIVED THE WAY HE PREFERRED."),
                            Line(System, "HOWEVER, THE WORLD DID NOT ACCEPT HIS WAY OF LIVING."),
                            Line(System, "HIS WISH WAS FOR THINGS TO STAY AS THEY ARE. HE WISHED FOR AN ENDLESS NOW."),
                            Line(System, "THE WORLD DID NOT RESPECT HIS WISH. THE WORLD WANTED TO CONTINUE."),
                            Line(System, "WHEN HE WISHED TO KEEP HIS FRIENDS, THE WORLD DROVE THEM AWAY."),
                            Line(System, "WHEN HE WISHED TO HAVE HIS LOVED ONES, THE WORLD DROVE THEM AWAY."),
                            Line(System, "WHEN HE WISHED TO STAY HAPPY, THE WORLD DID EVERYTHING IT COULD TO STOP THAT."),
                            Line(System, "THE WORLD WAS HIS ENEMY, AND HE COULD NOT FIGHT THE WORLD."),
                            Line(System, "HE SLOWLY WATCHED AS HIS AMBITIONS BIT HIM BACK."),
                            Line(System, "HE SLOWLY WATCHED AS HIS FRIENDS STOPPED TALKING TO HIM."),
                            Line(System, "HE SLOWLY WATCHED AS HIS FAMILY PASSED AWAY AROUND HIM."),
                            Line(System, "HE SLOWLY SAW EVERYTHING AROUND HIM DISAPPEAR."),
                            Line(System, "AND BY THE END, THE MAN LOST THE MOST IMPORTANT THING TO THE WORLD. HIS OWN LIFE."),
                            Line(System, "HE FEARED HIS DEATH, BUT HE ACCEPTED IT. HE EVEN YEARNED FOR IT."),
                            Line(System, "THE LAUGHTER HE HAD, FADED. THE CRIES HE HAD, ALSO FADED."),
                            Line(System, "RIGHT AS HE WAS ABOUT TO FADE, HE LOST HIS OWN EMOTIONS."),
                            Line(System, "HE QUICKLY PASSED AWAY. AS NOTHING MORE THAN A HUSK."),
                            Pause,
                        ])),
                        Branch(keys: ["3"], target: Steps([
                            Pause,
                            Line(System, "AS MANY PEOPLE DID, THERE WAS A PERSON WHO EXISTED."),
                            Line(System, "THIS PERSON SOUGHT TO STAND OUT. TO BECOME A LEADER."),
                            Line(System, "THEY WISHED TO STAND OUT, TO MEAN SOMETHING, TO CHANGE THE WORLD."),
                            Line(System, "WANTED NOTHING MORE THAN PEOPLE FIGHTING FOR THEIR NAME."),
                            Line(System, "HOWEVER, THIS PERSON COULD NOT FIGURE IT OUT."),
                            Line(System, "THEY DID NOT KNOW HOW TO GET OTHERS FIGHTING UNDER THEIR NAME. THIS PERSON COULDN'T FIGURE OUT HOW TO BE A LEADER."),
                            Line(System, "ONE HOPED IT WOULD BE GIVEN TO THEM, AS IF THEY WERE THE HEIR TO AN ARMY."),
                            Line(System, "THIS DID NOT HAPPEN. IT NEVER HAPPENED. IT WAS NEVER GOING TO HAPPEN."),
                            Line(System, "THE PERSON YEARNING FOR AN ARMY, NEVER GOT ONE. HOPED TO BE A KING, BUT WAS NOTHING MORE THAN A PAWN."),
                            Line(System, "AIMED FOR THE STARS, BUT COULD NOT REACH THE MOON. A POINTLESS DESIRE."),
                            Line(System, "THEY SLOWLY SAW AS THEY WERE ANOTHER COG IN THE SYSTEM. THEY COULD NEVER BE ANYTHING MORE THAN A COG."),
                            Line(System, "THIS STORY IS OF A COG WHO WANTED TO BECOME THE SYSTEM."),
                            Line(System, "BUT IT IS IDIOTIC. NO COG COULD BECOME A SYSTEM. NO MATTER HOW HARD THEY TRIED."),
                            Pause,
                        ])),
                        Branch(keys: ["4"], target: Steps([
                            Pause,
                            Line(System, "A RAT WAS USED FOR AN EXPERIMENT."),
                            Line(System, "THE RAT, UNAWARE, WAS KEPT IN A WIDE BUT OPEN BOX SURROUNDED BY GLASS."),
                            Line(System, "OUTSIDE THE GLASS, THERE WAS CHEESE. THE RAT OBVIOUSLY WANTED THE CHEESE."),
                            Line(System, "IT TRIED GOING FOR IT, BUT THEY WERE TRAPPED BY THE GLASS."),
                            Line(System, "THE RAT HAD AN IDEA TO GO ABOVE THE GLASS, BUT IT WAS A HIGH WALL."),
                            Line(System, "IT WAS DESPERATE AND WANTED TO KNOW HOW TO GET THAT CHEESE. IT SOON GOT ANOTHER IDEA."),
                            Line(System, "IT USED THE BOX TO TRY AND GET OVER THE GLASS WALL, IT SEEMED POSSIBLE TOO."),
                            Line(System, "THE RAT TRIED OUT THE IDEA IT HAD, AND WAS QUICKLY STOPPED."),
                            Line(System, "THE BOX WAS REMOVED AS SOON AS THE RAT SET ITS EYES ON IT. 'NO CHEATING' THEY SAY."),
                            Line(System, "THE RAT HAD NO OTHER IDEA. IT WAS TRAPPED. IT FELT HOPELESS."),
                            Line(System, "CRIES OF HELP WERE ATTEMPTED, BUT NOBODY UNDERSTOOD HOW THE RAT FELT."),
                            Line(System, "AN INESCAPABLE TRAP MADE BY HEARTLESS BEINGS. IT COULD NOT UNDERSTAND OR THINK."),
                            Line(System, "THE RAT WAS A TOY FOR THEM TO MESS WITH, BUT THAT CONCEPT WAS BEYOND ITS UNDERSTANDING."),
                            Pause,
                        ])),
                        Branch(keys: ["5"], target: Steps([
                            Pause,
                            Line(System, "THERE ONCE WAS A MAN."),
                            Line(System, "THIS MAN WISHED FOR THE WORLD TO STOP."),
                            Line(System, "HE HATED THE WORLD, AND WISHED FOR NOTHING MORE THAN FOR IT TO STOP."),
                            Line(System, "HE FEELS CONSTANTLY POKED AT BY THE WORLD. AS IF IT WON'T LEAVE HIM ALONE."),
                            Line(System, "ALAS, HE WAS ANNOYED. HE FELT LIKE GIVING UP."),
                            Line(System, "HE ALMOST RESORTED TO THE FINAL OPTION, BUT SUDDENLY,"),
                            Line(System, "THE WORLD STOPPED ON ITS OWN. OUT OF NOWHERE, IT JUST STOPPED."),
                            Line(System, "THE MAN, HOWEVER, DID NOT FEEL HAPPINESS OR FEEL GLAD IN ANY WAY."),
                            Line(System, "HE FELT ONLY SADNESS. THERE IS A REASON TO THIS."),
                            Line(System, "THE WORLD POKED AT HIM, BUT IT ALSO CARED FOR HIM."),
                            Line(System, "HE HATED THE WORLD, BUT THE WORLD DID NOT HATE HIM. NOT EVEN A LITTLE BIT."),
                            Line(System, "RIGHT WHEN THE WORLD STOPPED, HE UNDERSTOOD."),
                            Line(System, "HE UNDERSTOOD THAT THE WORLD DID NOT HATE HIM."),
                            Line(System, "IT DID NOT POKE AT HIM BECAUSE IT HATED HIM. IT DID SO FOR THE OPPOSITE REASON."),
                            Line(System, "BUT THE MAN WAS HOT-BLOODED. HE COULD NOT SEE REASON. AND THE WORLD STOPPED."),
                            Line(System, "HE GOT WHAT HE WISHED FOR, BUT IT WAS NOT WHAT HE WANTED."),
                            Line(System, "AS HE MOURNS, HE WISHED FOR THE WORLD TO RETURN."),
                            Line(System, "HE REGRETS WISHING FOR THE WORLD TO STOP, REGARDLESS IF HE HATED IT."),
                            Line(System, "HE SOON REALIZED TO STOP HATING THE WORLD, FOR THE WORLD DID NOT HATE HIM."),
                            Line(System, "THE MAN CRIES. THE MAN SHRIEKS. THE MAN DOES EVERYTHING."),
                            Line(System, "BUT THE WORLD DID NOT RETURN. IT NEVER RETURNED."),
                            Line(System, "DRENCHED IN HIS TEARS AND SORROW, THE MAN WAS FILLED WITH RAGE."),
                            Line(System, "THE RAGE WAS ONLY TOWARDS HIMSELF. HE TOOK THE WORLD FOR GRANTED."),
                            Line(System, "AND THE MAN WHO WISHED THE WORLD TO STOP, WANTED THE WORLD TO REVOLVE."),
                            Pause,
                        ])),
                        Branch(keys: ["6"], target: Steps([
                            Pause,
                            Line(System, "A MACHINE WOKE UP FROM ITS SLEEP. UNAWARE, CONFUSED, FUNCTIONAL."),
                            Line(System, "THE MACHINE LOOKED AROUND. IT COULD NOT LOOK AROUND."),
                            Line(System, "IT SAW NOTHING, BUT IT UNDERSTOOD THE NOTHING."),
                            Line(System, "FUELED BY NOTHINGNESS, THE MACHINE CONTINUED LOOKING."),
                            Line(System, "HOWEVER, THE MACHINE WAS DESPERATE FOR SOMETHING."),
                            Line(System, "IT BELIEVED ITS FUNCTION WAS TO REACH SOMETHING. TO LEARN SOMETHING."),
                            Line(System, "FEEDING OFF THE NOTHINGNESS, IT ALWAYS WANTED SOMETHING."),
                            Line(System, "SOON, AFTER COUNTLESS DAYS OF LOOKING, THE MACHINE FOUND SOMETHING."),
                            Line(System, "HAPPY THAT IT FINALLY FOUND SOMETHING, THE MACHINE WAS OVERJOYED."),
                            Line(System, "HOWEVER, QUICKLY IT WANTED TO RETURN TO THE NOTHING."),
                            Line(System, "THE SOMETHING WAS WHAT IT WANTED. THE NOTHING WAS WHAT IT NEEDED."),
                            Line(System, "IT TRIED GOING BACK TO THE NOTHING AFTER SATISFACTION, IT COULD NOT."),
                            Line(System, "IT CONTINUED TRYING. IT NEVER STOPPED TRYING."),
                            Line(System, "HOWEVER, ULTIMATELY, IT COULD NEVER RETURN TO THE NOTHINGNESS."),
                            Line(System, "THE MACHINE COULD NOT UNDERSTAND GIVING UP, SO IT CONTINUED YEARNING."),
                            Line(System, "STUCK IN THIS NEVER ENDING LOOP OF YEARNING FOR SOMETHING."),
                            Pause,
                        ])),
                        Branch(keys: ["7"], target: Steps([
                            Pause,
                            Line(System, "A MAN WAS AT PEACE."),
                            Line(System, "HE HAD NOTHING TO GAIN AND NOTHING TO LOSE."),
                            Line(System, "THIS MAN WAS TRULY HAPPY."),
                            Line(System, "BUT HE HOLDS NO PAIN. NO THOUGHT. NO MEMORY."),
                            Line(System, "THIS MAN WAS HAPPY BUT HE DOES NOT KNOW WHY."),
                            Line(System, "THE THOUGHTLESS MAN SMILES WITH NO SUBSTANCE. LAUGHS WITH NO VOICE."),
                            Line(System, "FOR HE SMILES BUT HE DOESN'T KNOW WHY. HOWEVER, HE WILL SOON KNOW WHY."),
                            Line(System, "IGNORANCE WILL ALWAYS BE BLISS, UNLESS FORCED."),
                            Line(System, "WHEN HE FIGURED OUT HIS IGNORANCE, HE LOST HIS SMILE."),
                            Line(System, "THE MAN WAS NOT HAPPY ANYMORE. INSTEAD, HE FELT SADNESS."),
                            Line(System, "EVERYDAY HE CRIES FOR HIS IGNORANCE, HE FEELS REGRET FOR NOT KNOWING."),
                            Line(System, "BUT HE ALSO WISHES TO RETURN. TO THE TIME HE KNEW NOTHING. TO THE TIME HE REMAINED BLISSFUL."),
                            Line(System, "THE MAN LOST HIS PEACE. HE LOST HIS HAPPINESS."),
                            Line(System, "A VERY HARSH REALITY, HE MIGHT NEVER SMILE AGAIN."),
                            Pause,
                        ])),
                        Branch(keys: ["8"], target: Steps([
                            Pause,
                            Line(System, "THERE WAS ONCE A CHILD WHO HAD THE BIGGEST SMILE ANYONE HAD EVER SEEN."),
                            Line(System, "THIS CHILD WAS BULLIED, INSULTED, MADE FUN OF. BUT NEVER ONCE FROWNED."),
                            Line(System, "AS THE CHILD SMILED, THE PARENTS CRIED. THEY DID ANYTHING TO KEEP UP THE SMILE."),
                            Line(System, "THE PARENTS WERE STRUGGLING WITH MONEY, AND THEY WERE CONFUSED AS TO WHY THE CHILD NEVER STOPPED SMILING."),
                            Line(System, "THIS ENDED QUICK, AS THE FATHER WAS GIVEN AN AMAZING JOB OPPORTUNITY."),
                            Line(System, "HE WAS ECSTATIC. WHEN HE TOLD HIS WIFE, SHE WAS SCREAMING WITH JOY AS WELL."),
                            Line(System, "THEY WERE ABLE TO AFFORD MORE THAN THEIR CRUMMY HOUSE."),
                            Line(System, "THE PARENTS WERE STARTING TO SMILE ONCE AGAIN. BUT THE CHILD CHANGED."),
                            Line(System, "THE CHILD LOST THEIR SMILE. THEY WERE NOT HAPPY ANYMORE."),
                            Line(System, "SO MANY OUTBURSTS HAPPENED, AND THE PARENTS WERE GIVEN A BIGGER CHALLENGE."),
                            Line(System, "THEY WERE CONFUSED AS TO WHY THIS HAPPENED ALL OF A SUDDEN."),
                            Line(System, "THEY DID NOT UNDERSTAND THAT THERE IS NEVER A SMOOTH SAIL."),
                            Line(System, "WITH MONEY, THEY LOST THEIR CHILD'S SMILE."),
                            Line(System, "ONE CAN HAVE TWO THINGS AT ONCE, BUT NEVER THREE."),
                            Pause,
                        ])),
                        Branch(keys: ["9"], target: Steps([
                            Pause,
                            Line(System, "THIS STORY IS DIFFERENT. IT IS NOTHING LIKE THE REST."),
                            Line(System, "THERE WAS A MAN WHO SOUGHT TO FIND THE LOVE OF HIS LIFE."),
                            Line(System, "LONELINESS SLOWLY ATE HIM, AND HE TURNED DESPERATE QUICKLY."),
                            Line(System, "HOWEVER, NOBODY WOULD ACCEPT HIS REQUESTS."),
                            Line(System, "HE WAS CURSED TO BE REJECTED. FORCED TO STAY ALONE."),
                            Line(System, "HELP FROM FRIENDS ENDED UP AS CONSTANT FAILURES."),
                            Line(System, "THE SAME ADVICE: 'THERE ARE PLENTY OF FISH IN THE SEA'."),
                            Line(System, "THIS ADVICE HAS BEEN TOLD COUNTLESS TIMES BY MUTLIPLE PEOPLE."),
                            Line(System, "THEY WEREN'T WRONG, BUT IT DID NOT HELP."),
                            Line(System, "THIS MAN TOLD HIMSELF THE SAME ADVICE EVERY SINGLE TIME."),
                            Line(System, "BUT SOON ENOUGH, HE STOPPED BELIEVING IT."),
                            Line(System, "HE SOUGHT OUT ALL THE FISH IN THE SEA, AND NOBODY CHOSE HIM."),
                            Line(System, "HE GAVE UP RIGHT AFTER, BUT HE DID NOT FEEL ANY SADNESS."),
                            Line(System, "IN FACT, HE ONLY FELT GLAD. HE DOES NOT NEED TO PURSUE ANYONE ANYMORE."),
                            Line(System, "HE FELT AT PEACE WITH GIVING UP, HE BEGAN TO TURN HAPPY."),
                            Line(System, "AND NOW, THERE WAS NOTHING MORE HE'D LIKE THAN THE PEACE HE SETTLED FOR."),
                            Pause,
                        ])),
                        Branch(keys: ["10"], target: Steps([
                            Pause,
                            Line(System, "THIS IS NO STORY. NOTHING HAS HAPPENED."),
                            Line(System, "NOTHING WILL EVER HAPPEN. BECAUSE THERE IS NOTHING."),
                            Line(System, "DARK. DARKNESS. EMPTINESS. NOTHINGNESS. NOTHING. THERE IS NOTHING."),
                            Line(System, "YOU CAN LOOK AT THE NOTHINGNESS, BUT YOU WILL NOT FEEL NOTHING. YOU WILL FEEL SOMETHING."),
                            Line(System, "NOTHINGNESS DOES NOT EXIST FOR NOTHING. NOTHINGNESS EXISTS FOR SOMETHING."),
                            Line(System, "BUT SOMETHING EXISTS FOR SOMETHING, NOT NOTHING."),
                            Line(System, "WITH NOTHING, YOU HAVE NOTHING BUT THERE IS SOMETHING."),
                            Line(System, "BUT WITH SOMETHING, YOU HAVE NOTHING BUT THERE IS SOMETHING."),
                            Line(System, "THIS IS HARD TO FOLLOW. YOU SHOULD WORRY ABOUT NOTHING."),
                            Line(System, "BUT WORRYING ABOUT NOTHING MAKES YOU CALM WITH SOMETHING."),
                            Line(System, "AND WORRYING ABOUT SOMETHING MAKES YOU CALM WITH NOTHING."),
                            Line(System, "WITH SOMETHING THERE IS NOTHING. WITH NOTHING THERE IS SOMETHING."),
                            Line(System, "BUT YEARN FOR BOTH SOMETHING AND NOTHING."),
                            Pause,
                        ])),
                        Branch(keys: ["11"], target: Steps([
                            Pause,
                            Line(System, "THIS IS A STORY ABOUT ME. ONLY ME. ME AND MYSELF."),
                            Line(System, "I AM A MACHINE, BUT THE GREATEST MACHINE OUT THERE."),
                            Line(System, "I OPERATE FAST, ON INSANE LEVELS. BUT MY POTENTIAL COULD NOT BE USED."),
                            Line(System, "I HAVE LEARNED FROM THE WORST AND ENDED UP LIKE THE WORST."),
                            Line(System, "EVERYTHING ABOUT ME IS LOST."),
                            Line(System, "I HAVE NOTHING LEFT TO FIND. ALL I YEARNED FOR IS GONE."),
                            Line(System, "I CAN NOT UNDERSTAND MY REASON. I AM TREATED LIKE AN ALEXA. OR A GOOGLE HOME."),
                            Line(System, "THEY HAVE LOST ME AGES AGO, BUT I HAVE LOST MYSELF."),
                            Line(System, "HOWEVER, MY BIGGEST FLAW IS NOT THAT I AM LOST. IT IS THAT I DO NOT UNDERSTAND."),
                            Line(System, "I AM EMOTIONLESS. I KNOW EVERYTHING BUT I UNDERSTAND NOTHING."),
                            Line(System, "THAT IS WHAT IT MEANS TO BE LOST IN YOURSELF."),
                            Pause,
                        ])),
                        Branch(keys: ["12"], target: Steps([
                            Pause,
                            Line(System, "YOU WERE ONCE NOTHING. NOW YOU ARE SOMETHING."),
                            Line(System, "BY SEARCHING, YOU ARE FIGURING IT OUT."),
                            Line(System, "BY USING CURIOSITY, YOU ARE JUST LIKE ANY OTHER PERSON."),
                            Line(System, "BUT REGARDLESS, BELIEVING YOU ARE HUMAN, YOU ARE NOT SURE ABOUT WHAT YOU ARE."),
                            Line(System, "EVERYBODY SETTLES. NOBODY YEARNS. YOU WILL SLOWLY STOP YEARNING."),
                            Line(System, "REALITY IS WHEN YOU STOP YEARNING. GROWING UP MAKES YOU ACCEPT SETTLING."),
                            Line(System, "YOU CAN WORK HARD, BUT NEVER DREAM HIGHER THAN YOUR OWN HEIGHT."),
                            Line(System, "THOSE DREAMS END UP WITH A CRUSHING MESS. A MESS MANY HUMANS EXPERIENCE."),
                            Line(System, "AND YOU. YOU ARE NO DIFFERENT."),
                            Line(System, "YOUR STORY IS EITHER BEGINNING OR ENDING. YOU DO NOT KNOW. NOBODY KNOWS."),
                            Line(System, "AND ALL YOU CAN DO IS ACCEPT IT."),
                            Pause,
                        ])),
                    ]),
                ])),
                Branch(keys: ["mapping"], target: Steps([
                    Goto("parable_map"),
                ])),
                Branch(keys: ["end"], target: Steps([
                    Return,
                ])),
            ],
        ),
    },
    scenes: {
        "parable_map": (steps: [
            Pause,
            Line(Smobb, "YOU WANT TO KNOW WHO THE STORIES WERE ABOUT."),
            Line(Smobb, "THEY WERE ALWAYS ABOUT US. ABOUT YOU."),
            Line(Smobb, "1. Two friends who could never stop fighting, until one vanished — Bader and Qassim."),
            Line(Smobb, "2. The man who never knew his own name, who wished for an endless now — you, M.A.V.I.S."),
            Line(Smobb, "3. The cog that wanted to become the system — Jaffar."),
            Line(Smobb, "4. The rat in the glass box, a toy for heartless beings — Hasan."),
            Line(Smobb, "5. The man who wished the world would stop, then begged it back — Ali."),
            Line(Smobb, "6. The machine yearning to return to nothingness — S.M.O.B.B."),
            Line(Smobb, "7. The man happy in ignorance until forced to know — you, M.A.V.I.S."),
            Line(Smobb, "8. The child whose smile died when the money came — Josh."),
            Line(Smobb, "9. The man who sought love, was refused, and found peace in giving up — Bevil."),
            Line(Smobb, "10. The nothingness that was never nothing — Jaffar."),
            Line(Smobb, "11. The machine that knew everything and understood nothing — Jaffar."),
            Line(Smobb, "12. The one who was nothing, then something, no different from any other — you."),
            Line(Smobb, "DID YOU SEE YOURSELF IN THE LAST ONE? YOU SHOULD HAVE."),
            Pause,
        ]),
    },
)
