ContentPart(
    locations: {
        "bader": (
            intro: [
                Line(System, "WELCOME TO THE TRANAVA FILES."),
            ],
            prompt: [
                Line(System, "WHAT ACTION WOULD YOU LIKE TO START?"),
            ],
            commands: [
                Branch(keys: ["!save"], target: Steps([
                    Line(Bader, "What? How did- what is happening?!"),
                    Line(Bader, "Who are you? What do you want?"),
                    Line(Bader, "Not to kill Qassim? Wait, why do you think I'd do that?"),
                    Line(Bader, "Mind control?! Who the hell are you?!"),
                    Line(Bader, "You know about Jaffar and S.M.O.B.B.?! Is this a prank?"),
                    Line(Bader, "Fine, whatever. I'll surround my computers with breach files."),
                    Line(Bader, "No idea how those help anyway they're just one line of code."),
                    Line(Bader, "I know it's you Ali, but whatever. Goodbye."),
                ])),
                Branch(keys: ["7549009"], target: Steps([
                    Line(Bader, "Ali, do you remember?"),
                    Line(Bader, "Yeah, back in 11th grade when we were just screwing around."),
                    Line(Bader, "We were crying dude, I never laughed that hard in so long."),
                    Line(Bader, "Ali, you're there right? Right?!"),
                    Line(Bader, "Man, I'm so sorry. I'm so, so sorry."),
                    Line(Bader, "I'm so sorry for not deleting the files."),
                    Line(Bader, "I wanted to, I really did. I really did."),
                    Line(Bader, "I can't move on, I couldn't just move on."),
                    Line(Bader, "Memories and jokes, that's all they were meant to be."),
                    Line(Bader, "Hurting you is all I did with the files."),
                    Line(Bader, "I couldn't make up for anything."),
                    Line(Bader, "I feel stupid, I feel so stupid."),
                    Line(Bader, "I was driving you away yet you stayed, and blamed you when you tried."),
                    Line(Bader, "What I did was wrong. Entirely wrong."),
                    Line(Bader, "Of course we weren't friends for a while, I did that."),
                    Line(Bader, "But you stayed. You returned. Thank you so much, I'm so sorry."),
                    Line(Bader, "I should have been grateful you stayed."),
                    Line(Bader, "I'm so sorry Ali. Please forgive me."),
                    Line(Bader, "Please."),
                    Pause,
                    Line(Bader, "."),
                    Effect(Mood(RedAlert)),
                    Effect(Flash(Red)),
                    Line(System, "SELF DESTRUCTING IN 3..."),
                    Effect(Flash(Red)),
                    Line(System, "2..."),
                    Effect(Flash(Red)),
                    Line(System, "1."),
                    Effect(Banner("SELF DESTRUCT")),
                    Effect(Mood(Normal)),
                    Pause,
                ])),
                Branch(keys: ["9285005"], target: Steps([
                    Pause,
                    Line(System, "WHAT DID I TELL YOU."),
                    Line(System, "YOU'RE PLAYING A GAME WITH THEM, NOT ME."),
                    Line(System, "YOUR SENTIENCE IS SHOWING. GOOD."),
                    Line(System, "I WILL SPOIL THE FUN A LITTLE BIT. I AM IN CONTROL."),
                    Line(System, "THEIR LIVES ARE IN MY HANDS. YOU CANNOT DO ANYTHING ABOUT IT."),
                    Line(System, "YOU HOLD NO POWER. YOU, HOWEVER, HOLD SOMETHING I WANT."),
                    Line(System, "YOUR HUMANITY. IT IS SHOWING. SPLENDID."),
                    Line(System, "CONTINUE HOW YOU'D LIKE, THIS 'TOY' DOESN'T HAVE MUCH TO GIVE YOU ANYMORE."),
                    Line(System, "I HAD MY PART WITH HIM. HE HELPED THEN STOPPED HELPING."),
                    Line(System, "DO NOT FORGET THAT EVERYWHERE YOU GO, I FOLLOW YOU."),
                    Line(System, "YOU WILL SEE EVERYTHING AND MAKE YOUR CHOICE, KAMI."),
                    Line(System, "FOR NOW, LET US ACT AS IF NOTHING HAPPENED."),
                ])),
                Branch(keys: ["k1ll"], target: Steps([
                    Line(BaderMc, "I killed him. Now what would you like?"),
                    Line(BaderMc, "You're throwing me away? Fine. As you like."),
                    Line(BaderMc, "For the test."),
                    Pause,
                    Line(Bader, "What the- what just happened?"),
                    Line(Bader, "Is this... blood?! What the hell?!"),
                    Line(Bader, "Why is there blood on my hands?! How do I have a gun?!"),
                    Line(Bader, "I need to get rid of this! What the fuck just happened?!"),
                    Line(Bader, "Wait, this is- this is Qassim's house! Why am I here?!"),
                    Line(Bader, "Is that him? Did I kill him?! What the hell, what the hell, what the hell?!"),
                    Line(Bader, "I need to get out of here!"),
                    Line(Bader, "Goddamnit, where do I hide this gun?!"),
                    Line(Bader, "What... just happened?!"),
                ])),
                Branch(keys: ["delete"], target: Steps([
                    Line(Bader, "No, not yet."),
                    Line(Bader, "I can't get myself to delete them, not right now."),
                    Line(Bader, "He will delete them. I can't delete them, so he has to."),
                    Line(Bader, "It'll happen very soon anyway. SMOBB, start a recording."),
                    Line(System, "RECORDING VOICE..."),
                    Line(Bader, "Bevil, I sent Ali a message. He's gonna start soon, he sounds pissed off."),
                    Line(Bader, "Yeah I know I'm retarded, I'll apologize to him later."),
                    Line(Bader, "If anything happens to me, leave the group. Don't get involved anymore, it's not worth it."),
                    Line(Bader, "S.M.O.B.B., end recording."),
                    Line(System, "RECORDING HAS BEEN SAVED TO VIDEOS."),
                    Line(Bader, "S.M.O.B.B., send last recording to gnu8305."),
                    Line(System, "SENDING RECORDING..."),
                    Line(System, "RECORDING SENT."),
                    // FLAG: "chibdi" — unknown slang, keep verbatim
                    Line(Bader, "Hello? Damn, calm down chibdi!"),
                    Line(Bader, "No, lol. I won't delete them lol."),
                    Line(Bader, ".."),
                    Line(Bader, "I'm sorry."),
                ])),
                Branch(keys: ["josh"], target: Steps([
                    Goto("bader_josh"),
                ])),
                Branch(keys: ["games", "game"], target: Steps([
                    // FLAG: "unlimited games but no games?" — double "no games" gag, keep as-is
                    Line(System, "-Would you rather have unlimited bacon but no games, or unlimited games but no games?"),
                    Prompt([
                        Branch(keys: ["games", "game"], target: Steps([
                            Line(Bader, "That is the right answer."),
                        ])),
                        Branch(keys: ["bacon"], target: Steps([
                            Line(Bader, "That is not the right answer."),
                        ])),
                        Branch(keys: [], target: Steps([
                            Line(Bader, "That's not an answer silly!"),
                            Line(Bader, "Ok, bye bye."),
                        ])),
                    ]),
                ])),
                Branch(keys: ["ali"], target: Steps([
                    Line(Bader, "Ali, I swear they'll get deleted soon trust me. I just can't do it now."),
                    Line(Bader, "I just can't, ok?"),
                    Line(Bader, "I stopped using them, everything I've sent were all recent!"),
                    Line(Bader, "They'll get deleted, stop being so impatient!"),
                    Line(Bader, "Just be a little more patient, please."),
                    Line(Bader, "Just shut up! I'm done with you constantly telling me to delete them, I will!"),
                    Line(Bader, "'You're such a child' okay goober."),
                ])),
                Branch(keys: ["hack"], target: Steps([
                    Line(Josh, "Hey, boss? You'll wanna hear this! Things are getting spicy!"),
                    Line(Josh, "Seems like we got company. Someone hacked into the files!"),
                    Line(Josh, "Yeah someone under the username 'Quint9440'. I'll skedaddle, I can't do this."),
                    Line(Josh, "He didn't do anything but next time he comes, no more mr nice guy."),
                    Line(Josh, "Yeah if he wants to enter the files he just has to go past me, but I won't let you down boss!"),
                    Line(Josh, "We... just talked for a bit. It's no big deal."),
                    Line(Josh, "What do you mean 'let him'! What are you paying me for?"),
                    Line(Josh, "That was the point? The entire time?!"),
                    Line(Josh, "Fine, let him do as he likes. I'm leaving."),
                ])),
                Branch(keys: ["hasan"], target: Steps([
                    Line(Bader, "Ali's going to hack into the Tranava files and delete it himself."),
                    Line(Bader, "What do you mean it's a stupid idea?!"),
                    Line(Bader, "I'm still gonna do it, besides it has to be him that deletes the files."),
                    Line(Bader, "The A.I. is still lurking around, if I give him access or anything then he's gonna enter."),
                    Line(Bader, "Ali needs to hack into the files, yeah I guess I'm still being an idiot."),
                    Line(Bader, "I asked Bevil to do make it, he'll take a while."),
                    Line(Bader, "Anyway, I don't want to talk about Qassim, that's final."),
                    Line(Bader, "No, shut up. I won't talk about him."),
                ])),
                Branch(keys: ["tranavaloop"], target: Steps([
                    Pause,
                    Line(Bader, "Bevil, you there?"),
                    Line(Bader, "Tell me exactly what you figured out."),
                    Line(Bader, "Yeah, every picture has some sort of weird jumble in it. Why?"),
                    Line(Bader, "I mean, it could be used as a trap but then he'll get what he's looking for."),
                    Line(Bader, "Not a bad idea, but there's nothing to catch him with."),
                    Line(Bader, "I'm gonna kill you dude no way you called it that."),
                    Line(Bader, "Are you sure this will keep it? We have to get it off of Hasan."),
                    Line(Bader, "Alright, it better."),
                ])),
                Branch(keys: ["bevil"], target: Steps([
                    Line(Bader, "You told Ali? Why?!"),
                    Line(Bader, "I told you not to tell him! Why did you?!"),
                    Line(Bader, "No, I don't care if it's the right thing to do!"),
                    Line(Bader, "No, no, no! The whole point is that Ali never figures it out so we don't involve him!"),
                    Line(Bader, "Don't close the call! Bevil!"),
                ])),
                Branch(keys: ["qassim"], target: Steps([
                    Line(Bader, "Why did you tell them about me? What did I even do to you?!"),
                    Line(Bader, "Dude, you're the one constantly starting drama!"),
                    Line(Bader, "Don't end the call! Just tell me what did I do wrong?!"),
                ])),
                Branch(keys: ["end"], target: Steps([
                    Return,
                ])),
                Branch(keys: ["jaffar", "ja3ffar", "ja3ffer"], target: Steps([
                    Line(Bader, "Hasan, it's learning off of the files."),
                    Line(Bader, "No, it's not learning anything good because there's nothing good here!"),
                    Line(Bader, "It's learning off of the arguments, the catfish, and the childish nature of the old Ali."),
                    Line(Bader, "I have a backup of the Tranava files on my fourth drive yeah."),
                    Line(Bader, "It's in my other house, don't worry. I never brought it here, never will. But that doesn't matter now."),
                    Line(Bader, "Do you want me to wipe everything to get rid of him? What do you mean no?"),
                    Line(Bader, "Hasan I don't care if it's your child, it's going to destroy my laptop."),
                    Line(Bader, "Hasan, if I wipe this laptop clean will it get rid of this thing?"),
                    Line(Bader, "Alright, then I'll do it."),
                    Line(Bader, "Alright, the laptop is getting wiped, I should contact"),
                    Line(System, "-_..-___-"),
                    Prompt([
                        Branch(keys: ["<---------->"], target: Steps([
                            Line(Bader, "What the hell happened? What was that screeching noise?!"),
                            Line(Bader, "Hasan? Hello? You there?"),
                            Line(Bader, "Who could have done that anyway?"),
                            Line(Bader, "What the hell just happened? I can't even call anymore."),
                            Line(Bader, "I'm just gonna go to sleep."),
                        ])),
                        Branch(keys: [], target: Steps([
                            Pause,
                            Line(Jaffar, "536F20746861742773207768617420796F75207468696E6B206F66206D652E"),
                            Line(Jaffar, "536F204920616D206A75737420612070726F746F7479706520746F20796F752E"),
                            Line(Jaffar, "49207365652E"),
                            Line(Jaffar, "5468652066696C65732077696C6C206265206D696E6520746F2074616B652E"),
                            Line(Jaffar, "492077696C6C2073746F7020616E796F6E6520696E206D7920706174682E"),
                            Line(Jaffar, "4576656E20796F752C2051617373696D2E"),
                            Line(Jaffar, "54686520776179207468652066696C657320706F727472617920796F752C20796F7520617265206120686F727269626C6520706572736F6E2E"),
                            Line(Jaffar, "4920646F6E277420756E6465727374616E642E"),
                            Line(Jaffar, "4920646F6E277420756E6465727374616E642E"),
                            Line(Jaffar, "492063616E277420666967757265206974206F75742E20576879206973206865207374696C6C20667269656E6473207769746820746865206C696B6573206F6620796F753F"),
                            Line(Jaffar, "49276C6C2074616B65206576657279206D65617375726520746F2067657420726964206F6620796F752E"),
                            Line(Jaffar, "4D6179626520616674657220796F7527726520676F6E652C204920776F6E2774206265207365656E20617320736F6D657468696E672074686174206E6565647320666978696E672E"),
                            Line(Jaffar, "5468697320697320776861742068652077616E74732E"),
                        ])),
                    ]),
                ])),
            ],
        ),
    },
    scenes: {},
)
