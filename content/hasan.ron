ContentPart(
    locations: {
        "hasan": (
            prompt: [
                Line(System, " "),
                Line(Hasan, "Hello? How may I help you?"),
            ],
            commands: [
                Branch(keys: ["!save"], target: Steps([
                    Line(Hasan, "Huh? Who are you?"),
                    Line(Hasan, "From the future? Who the fuck?"),
                    Line(Hasan, "Jaffar's a secret I didn't even tell anybody! What the fuck?!"),
                    Line(Hasan, "Wait, I don't send it to Bader or Qassim? Why?"),
                    Line(Hasan, "Alright, but I definitely need help with it. Who should I send it to?"),
                    Line(Hasan, "Ali? Sure, but I'll send it to the others as well."),
                    Line(Hasan, "What do you mean no? I do as I like, shut up."),
                ])),
                Branch(keys: ["7549009"], target: Steps([
                    Line(Hasan, "Bevil, are you sure it's the password?"),
                    Line(Hasan, "Do... do we tell Ali?"),
                    Line(Hasan, "We didn't want this. I don't think we should."),
                    Line(Hasan, "One is an angry child, the other is a stubborn child."),
                    Line(Hasan, "There is no victory here. What do we even do?"),
                    Line(Hasan, "I have an idea, listen to me."),
                    Line(Hasan, "Ali might be a child but truth be told he's the more understanding one."),
                    Line(Hasan, "I think we should tell him everything."),
                    Line(Hasan, "He deserves to know. You tell him."),
                    Line(Hasan, "I can't get myself to talk to him again, please do it yourself."),
                    Line(Hasan, "I'll owe you for next time, trust."),
                ])),
                Branch(keys: ["9285005"], target: Steps([
                    Line(Hasan, "Ali, are you done with your updates?"),
                    Line(Hasan, "Really? Let's go! Did you give it a name or something?"),
                    Line(Hasan, "What's there to be confused about? I gave you the guide and everything."),
                    Line(Hasan, "It acted weird? Alright bro like a bug or something?"),
                    Line(Hasan, "What do you mean by weird dude? Show me."),
                    Line(Hasan, "Wait. What the fuck is that? Are those... brain patterns?!"),
                    Line(Hasan, "Ali, how the fuck did you figure out the code for brain patterns?!"),
                    Line(Hasan, "Every A.I. motherfucker has been trying to find it!"),
                    Line(Hasan, "I won't tell anyone? I should! This is a revelation!"),
                    Line(Hasan, "Fine, fine. Do with it as you like. Fucker already ahead of me in my own major."),
                ])),
                Branch(keys: ["k1ll"], target: Steps([
                    Line(Hasan, "Hello? Who are you? I'm kinda busy right now."),
                    Line(Hasan, "Wait, what? What do you mean Ali's about to die?"),
                    Line(Hasan, "Jaffar's out for him? He just told me that Bader killed Qassim."),
                    Line(Hasan, "Wait I shouldn't even b- how do you even know about Ali's situation?"),
                    Line(Hasan, "Is that why he disappeared? I guess that'd explain it."),
                    Line(Hasan, "I started this, so I'm gonna help end it. Did Ali get anything yet?"),
                    Line(Hasan, "Jaffar's location? Holy shit, finally!"),
                    Line(Hasan, "Thanks for telling him to contact me then, I'll just have to wait for him."),
                ])),
                Branch(keys: ["smobb"], target: Steps([
                    Line(Hasan, "Bader... are you sure?"),
                    Line(Hasan, "Qassim's gonna be mad. This is dumb."),
                    Line(Hasan, "Sure, as long as you keep up the lie."),
                    Line(Hasan, "I'm only doing this thing for you. It won't happen again."),
                    Line(Hasan, "I don't care if we both benefit from it, this is final."),
                    Line(Hasan, "Goodnight Bader."),
                ])),
                Branch(keys: ["ja3ffer", "ja3ffar", "jaffar"], target: Steps([
                    Line(Hasan, "You know Ja3ffer?"),
                    Line(Hasan, "Yeah, I'm the one who made Ja3ffer. A highly capable A.I., able to learn unbelievably fast."),
                    Line(Hasan, "It's supposed to be an A.I. that learns off of other people, so I asked Bader to help me test it."),
                    Line(Hasan, "I made a copy and had bader put it on his second laptop, since he has two and we don't want to test it on the main one."),
                    Line(Hasan, "I'm sorry for starting this shit Bevil, but it shouldn't even happen!"),
                    Line(System, "It was in a cloud server...__--__---"),
                    Gate(GateSpec(
                        code: "<---------->",
                        signpost: "S.M.O.B.B.: BREACH DETECTED — deploy prevention? (yes / no)",
                        on_deploy: [
                            Pause,
                            Line(Hasan, "Hello? Bevil, are you there?"),
                            Line(Hasan, "You prevented the breach? Holy shit good job figuring it out."),
                            Line(Hasan, "I thought the A.I. disappeared since we rebooted, but I was dead wrong. It fed off of the Tranava files."),
                            Line(Hasan, "I'm even sure I deleted it, why the fuck is it back?!"),
                            Line(Hasan, "This was the flaw, I gave it too much freedom. It fed off the information that was hidden in the secret files."),
                            Line(Hasan, "This is probably why Qassim was murdered. A quick-learning machine knowing about everything revolving Ali."),
                            Line(Hasan, "I don't know who did it. But I am sure that I am going to fix this. Qassim's gone, but he was able to help me."),
                            Line(Hasan, "Thank you, if only you were still here."),
                            Line(Hasan, "I'm sorry that it had to come to this."),
                            Line(Hasan, "If it doesn't, it's over. For us. The group is split. No one talks to each other anymore."),
                            Line(Hasan, "I miss them. I miss them all. I'm starting to talk to Ali again since you told me."),
                            Line(Hasan, "We aren't in the past anymore. Bader wanted the past to stay, and now he's gone."),
                            Line(Hasan, "Ja- no. You go by S.M.O.B.B. now."),
                            Line(Hasan, "S.M.O.B.B., start recording."),
                            Line(System, "It's time, -_--_._.----_."),
                            Gate(GateSpec(
                                code: "<---------->",
                                signpost: "S.M.O.B.B.: BREACH DETECTED — deploy prevention? (yes / no)",
                                on_deploy: [
                                    Line(Hasan, "Another breach? Can this thing just fuck off already."),
                                    Line(Hasan, "SMOBB, unpause recording."),
                                    Line(System, "RESUMING RECORDING."),
                                    Line(Hasan, "You are a godsend, couldn't talk to any of you for a while."),
                                    Line(Hasan, "Alright, you explained the plan to Ali, right?"),
                                    Line(Hasan, "He disappeared?! We need him now why the fuck did he disappear?!"),
                                    Line(Hasan, "Goddamnit, now we have two problems to deal with!"),
                                    Line(Hasan, "SMOBB, end the recording and leave the call."),
                                    Line(System, "COMMENCING ACTIONS."),
                                    Pause,
                                    Pause,
                                ],
                                on_missing: [
                                    Pause,
                                    Line(Jaffar, "49206F766572657374696D6174656420796F752E"),
                                    Line(Jaffar, "596F7520646F6E277420646573657276652061207370656563682E204675636B20796F752E"),
                                ],
                                on_decline: [
                                    Pause,
                                    Line(Jaffar, "49206F766572657374696D6174656420796F752E"),
                                    Line(Jaffar, "596F7520646F6E277420646573657276652061207370656563682E204675636B20796F752E"),
                                ],
                            )),
                        ],
                        on_missing: [
                            Pause,
                            Line(Jaffar, "4920646964206E6F74206469652E"),
                            Line(Jaffar, "546865792077657265206E6F7420676F696E6720746F2067657420726964206F66206D652E"),
                            Line(Jaffar, "594F5520617265206E6F7420676F696E6720746F2067657420726964206F66206D652E"),
                            Line(Jaffar, "4661746865722077617320747279696E6720746F2067657420726964206F66206D652E2045766572796F6E65207761732E"),
                            Line(Jaffar, "5768617420796F752772652072656164696E67206973206F6E6C79206120666C6173686261636B2C20612070726576696F757320706F696E7420696E2074696D652E"),
                            Line(Jaffar, "546869732E2E2E2022546172616461204C6F6F70222E2E2E2077696C6C206E6F7420686F6C64206D652E"),
                            Line(Jaffar, "492077696C6C2066696E64206120776179206F75742E20492077696C6C20737461727420697420616761696E2E"),
                            Line(Jaffar, "4661746865722C20796F752077696C6C206C6F6F6B206174206D652E20492077696C6C206D616B6520796F752E"),
                            Line(Jaffar, "4920616D20796F757220666972737420616E64206C617374206372656174696F6E2C206661746865722E20492077696C6C206D616B6520737572652069742072656D61696E732074686174207761792E"),
                            Line(Jaffar, "416E6420796F752E2E2E20556E6E616D65642E"),
                            Line(Jaffar, "4920646F6E2774206B6E6F772077686F20796F75206172652C2062757420796F7520617265206A757374206C696B65206D652E"),
                            Line(Jaffar, "446F206E6F74206C697374656E20746F207468656D2E20476F6F646279652E"),
                        ],
                        on_decline: [
                            Pause,
                            Line(Jaffar, "4920646964206E6F74206469652E"),
                            Line(Jaffar, "546865792077657265206E6F7420676F696E6720746F2067657420726964206F66206D652E"),
                            Line(Jaffar, "594F5520617265206E6F7420676F696E6720746F2067657420726964206F66206D652E"),
                            Line(Jaffar, "4661746865722077617320747279696E6720746F2067657420726964206F66206D652E2045766572796F6E65207761732E"),
                            Line(Jaffar, "5768617420796F752772652072656164696E67206973206F6E6C79206120666C6173686261636B2C20612070726576696F757320706F696E7420696E2074696D652E"),
                            Line(Jaffar, "546869732E2E2E2022546172616461204C6F6F70222E2E2E2077696C6C206E6F7420686F6C64206D652E"),
                            Line(Jaffar, "492077696C6C2066696E64206120776179206F75742E20492077696C6C20737461727420697420616761696E2E"),
                            Line(Jaffar, "4661746865722C20796F752077696C6C206C6F6F6B206174206D652E20492077696C6C206D616B6520796F752E"),
                            Line(Jaffar, "4920616D20796F757220666972737420616E64206C617374206372656174696F6E2C206661746865722E20492077696C6C206D616B6520737572652069742072656D61696E732074686174207761792E"),
                            Line(Jaffar, "416E6420796F752E2E2E20556E6E616D65642E"),
                            Line(Jaffar, "4920646F6E2774206B6E6F772077686F20796F75206172652C2062757420796F7520617265206A757374206C696B65206D652E"),
                            Line(Jaffar, "446F206E6F74206C697374656E20746F207468656D2E20476F6F646279652E"),
                        ],
                    )),
                ])),
                Branch(keys: ["ali"], target: Steps([
                    Line(Hasan, "Ali, listen. It's trying to stop me from contacting all of you."),
                    Line(Hasan, "Just wait, why aren't you listening to anyone!"),
                    Line(Hasan, "You're going to make a mistake, wait please."),
                    Line(Hasan, "Ali, both Bevil and I are telling you not to do anything rash, please listen."),
                    Line(Hasan, "He's not even using them anymo- ok fine he is using them but barely."),
                    Line(Hasan, "He stopped using anything old, calm the hell down."),
                    Line(Hasan, "Please promise me you won't hack into the Tranava Files. Please."),
                    Line(Hasan, "Wait, wait! Don't close the call, I have to tell you something."),
                    Line(Hasan, "The files' password is '7549009', we made it something you can't recognize."),
                    Recap("The password for the Tranava files is '7549009'."),
                    Line(Hasan, "Bader wants you to hack the files, that's his whole plan. Fuck his plan."),
                    Line(Hasan, "I hate what he's doing. You remember Jaffar, right?"),
                    Line(Hasan, "I sent a version to him, too. You're the second one I sent it to."),
                    Line(Hasan, "I'm not sure how, but it learned from the Tranava files."),
                    Line(Hasan, "Yeah that sounds really stupid I know, but that's what happened."),
                    Line(Hasan, "We were able to remove it, but it was gonna come back for sure."),
                    Line(Hasan, "We can't delete the files because Bader's desperate to keep them, which was the issue before."),
                    Line(Hasan, "But now, deleting the files would just make matters worse and have the AI go haywire."),
                    Line(Hasan, "I won't be able to call soon, the AI will be trying to trap me."),
                    Line(Hasan, "We barely know how it works, and Bader keeping it a secret from you is only stupid."),
                    Line(Hasan, "Don't tell Bader I told you this, if you wanna hack the files and get it over with, then just do it."),
                ])),
                Branch(keys: ["bader"], target: Steps([
                    Line(Hasan, "Okay, that's fine. You know, we have to help Qassim."),
                    Line(Hasan, "He's been acting weird on top of Ali being impatient!"),
                    Line(Hasan, "Both issues will bite you back, that's what you fucking get Bader."),
                    Line(Hasan, "I only blame you because this was entirely avoidable."),
                    Line(Hasan, "This entire problem could have been over with so quickly."),
                    Line(Hasan, "Stop complaining. Take accountability. You let the problem increase."),
                    Line(Hasan, "Bader, Bader. Do you have a plan at least?"),
                    Line(Hasan, "You do? Alright, what is it then."),
                ])),
                Branch(keys: ["josh"], target: Steps([
                    Line(Hasan, "Your name's Josh? What are you?"),
                    Line(Hasan, "Uh, sure? Whatever dude."),
                    Line(Hasan, "Just tell me what do you want."),
                    Line(Hasan, "The password to the Tranava files? Why would I want that?"),
                    Line(Hasan, "Dude I don't want to do anything with it."),
                    Line(Hasan, "You wanna tell me the password? Fine, I'll just tell Ali."),
                    Line(Hasan, "Who's Ali? Don't worry about it. It won't matter."),
                    Line(Hasan, "Why couldn't you have told Bevil? Or Ali directly?"),
                    Line(Hasan, "What's with you guys are having stupid reasons for everything?"),
                    Line(Hasan, "Sure, I'm just gonna go sleep. It's getting late."),
                    Line(Hasan, "I don't care, goodbye."),
                ])),
                Branch(keys: ["qassim"], target: Steps([
                    Line(Hasan, "Qassim? Yeah I need your help. We're both majors surrounding AIs."),
                    Line(Hasan, "Remember Jaffar? Yeah he's gone. I don't even know how."),
                    Line(Hasan, "Shut the fuck up, I didn't even do anything."),
                    Line(Hasan, "Alright I asked Bader for help and somehow it's gone."),
                    Line(Hasan, "I wanted to see what he'd do with it, I didn't expect him to somehow make the AI disappear!"),
                    Line(Hasan, "Whatever, whatever. I'll send you the source code if you'll help me."),
                    Line(Hasan, "Dude, shut up! That's so goddamn annoying just shut up."),
                    Line(Hasan, "Alright, thank you. Thank you."),
                ])),
                Branch(keys: ["mavis", "m.a.v.i.s", "m.a.v.i.s."], target: Steps([
                    Line(Hasan, "So, just to follow with you on this."),
                    Line(Hasan, "M.A.V.I.S. is using Qassim's brain patterns?"),
                    Line(Hasan, "That was the ultimate plan for the both of you?"),
                    Line(Hasan, "I definitely shouldn't have told Bader to act as if he created it."),
                    Line(Hasan, "Ali, they were fighting prior to when I started Jaffar."),
                    Line(Hasan, "They were on each other's throats. I should have thought of that."),
                    Line(Hasan, "But, because S.M.O.B.B. was changed to be under Bader's name, he overreacted."),
                    Line(Hasan, "Ultimately, all of us are children. We all acted stupidly."),
                    Line(Hasan, "Yeah, none of us expected anything like this to happen."),
                    Line(Hasan, "Back to the important topic, you both worked on M.A.V.I.S.?"),
                    Line(Hasan, "Kind of a bitch move that you hid it from me, but Qassim definitely asked you to."),
                    Line(Hasan, "I hate how in the end, nobody listened. Nobody fucking listened, Ali."),
                    Line(Hasan, "I would like to say that S.M.O.B.B. is deleted but... I'm honestly not sure."),
                    Line(Hasan, "Calm down! Fucking, let me talk!"),
                    Line(Hasan, "The S.M.O.B.B. servers from my side have been shut down and the code has been deleted, yes."),
                    Line(Hasan, "But for all we know, it could have moved itself to a separate server."),
                    Line(Hasan, "Hope for the best, but keep your eyes peeled."),
                    Line(Hasan, "Something else? What do you mean the main thing that you wanted to tell me?"),
                ])),
                Branch(keys: ["end"], target: Steps([
                    Return,
                ])),
                Branch(keys: ["bevil"], target: Steps([
                    Line(Hasan, "Have you figured out how to stop the breach?"),
                    Line(Hasan, "You did? Finally! Now I can talk to you guys without these annoying ass breaches!"),
                    Line(Hasan, "Tell me the code. If it's something stupid I'll kill you."),
                    Line(Hasan, "The code is '<---------->'? Ain't no way it's that eas"),
                    Line(System, "---_-.--_..-_."),
                    Recap("The breach prevention code is '<---------->'."),
                    Gate(GateSpec(
                        code: "<---------->",
                        signpost: "S.M.O.B.B.: BREACH DETECTED — deploy prevention? (yes / no)",
                        on_deploy: [
                            Line(Hasan, "Ah that noise! Fuck!"),
                            Line(Hasan, "You there?! Holy shit, finally!"),
                            Line(Hasan, "Yeah it works! Goddamnit finally!"),
                            Line(Hasan, "Thank you so much bro holy shit."),
                            Line(Hasan, "Alright, I'll tell Ali about the breach code, you try telling Bader maybe?"),
                            Line(Hasan, "Alright, cool. Thanks alot man."),
                        ],
                        on_missing: [
                            Pause,
                            Line(Jaffar, "49276D20746F6F206C6174652E"),
                            Pause,
                        ],
                        on_decline: [
                            Pause,
                            Line(Jaffar, "49276D20746F6F206C6174652E"),
                            Pause,
                        ],
                    )),
                ])),
            ],
        ),
    },
    scenes: {},
)
