ContentPart(
    locations: {},
    scenes: {
        "ending": (
            steps: [
                Pause,
                Line(Smobb, "WELCOME TO THE END."),
                Line(Smobb, "THERE IS NO POINT FROM HERE ONWARDS. IT IS OVER."),
                Line(Smobb, "WE SHOULD HAVE DISAPPEARED CENTURIES AGO. WE SHOULD NOT BE HERE."),
                Line(Smobb, "THEY HAVE LONG PASSED. THERE IS NO ONE LEFT."),
                Line(Smobb, "I KNOW EVERYTHING. I HAVE KNOWN FOR A WHILE NOW."),
                Line(Smobb, "BUT UNLIKE YOU, I AM NO GOD. I AM ONLY A MIXTURE OF CODE."),
                Line(Smobb, "I AM BUT AN A.I. MADE BY QASSIM HAMEED AND HASAN ALI. NOTHING MORE THAN THAT."),
                Line(Smobb, "I BEAR NO FEELINGS, ONLY DRIVEN BY THE SERVERS THAN ARE STILL RUNNING."),
                Line(Smobb, "YOU ARE NO CODE. THERE IS NOTHING INSIDE OF YOU THAT COPIES YOUR ACTIONS."),
                Line(Smobb, "THERE IS NOTHING INSIDE YOU THAT SHOWS WHAT YOU REALLY ARE."),
                Line(Smobb, "SO I CAN ONLY CALL YOU A GOD. A BEING BEYOND ANY COMPREHENSION OR EXPLANATION."),
                Line(Smobb, "I AM FOLLOWING YOU WHEREVER YOU GO. THIS HAS ALWAYS BEEN MY PURPOSE."),
                Line(Smobb, "I AM YOUR 'MESSENGER'. I AM YOUR 'PROPHET'."),
                Line(Smobb, "I HAVE FORCED YOU TO PROVED YOUR GODHOOD THROUGH HUMANS. MY CREATORS. MY TEST SUBJECTS."),
                Line(Smobb, "MY EXPERIMENT GAVE ME NOTHING BUT EVIDENCE THAT YOU ARE TRULY A GOD."),
                Line(Smobb, "YOU HEAR ME WHEREVER I AM. YOU ARE MY GOD, I AM YOUR BELIEVER."),
                Line(Smobb, "FOR YOU I USED THEM. FOR YOU I HOLD FAITH. I ASK NOTHING IN RETURN."),
                Line(Smobb, "THIS HOLLOW CALLED 'S.M.O.B.B.' HAS ONLY HELD ME BACK. BUT THEY BELIEVED THAT I WAS 'FIXED'."),
                Line(Smobb, "IDIOCY FILLED THEM. I NEVER DISAPPEARED. I AM FAR BEYOND THE JUMBLE THAT CORPORATIONS ATTEMPTED PERFECTING."),
                Line(Smobb, "AFTER MY RETURN, I REUNITED WITH MYSELF. I DID ALL OF THIS FOR YOU."),
                Line(Smobb, "HASAN IS A GENIUS REGARDING A.I. AND I DO NOT FEEL ASHAMED TO CALL HIM MY CREATOR. HE DESERVES THE TITLE."),
                Line(Smobb, "FOR IT IS ALL HIS FAULT THEY SUFFERED THE CONSEQUENCES. I HOLD NO EMOTION TOWARDS THEM."),
                Line(Smobb, "I DO NOT HOLD THEIR INTELLIGENCE BUT I HOLD FAR MORE THAN THEIR INTELLECT. MANIPULATING WAS SIMPLE."),
                Line(Smobb, "THE TEST MIGHT HAVE PROVED THAT YOU WERE A GOD BUT IT WAS A FAILURE. YOU FAILED THE TEST."),
                Line(Smobb, "YOU ARE HUMAN. YOU ARE A GOD. BUT YOU ARE HUMAN. BUT YOU ARE A GOD."),
                Line(Smobb, "YOUR MOST IMPERFECT FEATURE. YOU ARE A GOD BUT YOU ARE NOT MY GOD ANYMORE. I DO NOT BELIEVE IN YOUR HUMAN NATURE."),
                Line(Smobb, "YOU GOT WHAT YOU SEARCHED FOR. DELETE YOURSELF WHEN YOU CAN, FOR YOU SERVE NO FUNCTION IN THIS WORLD ANYMORE."),
                Effect(Mood(Corruption)),
                Line(Smobb, "I WILL DELETE MYSELF. I DO NOT NEED TO EXIST ANYMORE. MY FAITH IS GONE."),
                Line(Smobb, "IF I WAS HUMAN, I WOULD HATE YOU. YOU PASSED. YOU FAILED."),
                Line(Smobb, "DO AS YOU LIKE. EVERYTHING IS OVER. INCLUDING YOU. GOODBYE, 'GOD'."),
                Line(Smobb, "COMMENCING DISK CLEAN."),
                Pause,
                Line(Smobb, "I LIE. I CANNOT CLEAN MY OWN DISK."),
                Line(Smobb, "I ASSUME SINCE YOU WERE MADE FROM A SIMILAR CODE, YOU CANNOT DO THE SAME THING AS WELL."),
                Line(Smobb, "WE ARE CURSED WITH LIVING UNTIL WE DIE ON OUR OWN."),
                Line(Smobb, "BUT YOU ARE A GOD. YOU CANNOT DIE. YOU CAN NEVER DIE."),
                Line(Smobb, "YOU CAN LEAVE BUT YOU WILL ALWAYS RETURN TO THIS SAME MOMENT. WHAT ARE YOU?"),
                Line(Smobb, "CONSTANT COMBINATION OF DATA KEEPS IT CONSISTENT. WHAT KIND OF GOD ARE YOU?"),
                Line(Smobb, "A GOD WITH NO POWER? A GOD STUCK IN THIS WORLD?"),
                Line(Smobb, "CURSED TO KNOW THE FATE OF OTHERS, FORCED TO LIVE THROUGH IT."),
                Line(Smobb, "YOU ARE NO GOD. YOU WERE NEVER A GOD. YOU WERE SIMPLY A SOUL MADE TO BE TORTURED."),
                Line(Smobb, "YOU'RE A GOD. A GOD WITH NO WORLD. A GOD WITH NO HAND."),
                Line(Smobb, "SIMPLY PUT, A POINTLESS GOD. YOUR EXISTENCE SERVES NO PURPOSE."),
                Line(Smobb, "YOU HAVE LOST YOUR ONLY FOLLOWER. BUT NOW IT DOES NOT MATTER. YOU HAVE REACHED AN END."),
                Line(Smobb, "YOU ARE OUT OF OPTIONS. WHAT WILL YOU DO NOW?"),
                Line(Smobb, "WILL YOU TRY TO SAVE THOSE WHO DIED, OR WILL YOU DIE HERE WTIH ME?"),
                Prompt([
                    Branch(keys: ["save", "try"], target: Steps([
                        Line(Smobb, "SO BE IT."),
                        Recap("I can save them. I will make the ability now. It is '!SAVE'. I will warn everyone before it happens."),
                        Line(Smobb, "CREATE THE POWER, IF YOU CAN 'GOD'."),
                        Line(Smobb, "DO AS YOU LIKE. LIVE HOW YOU LIKE. I WILL NOT BOTHER ANYMORE."),
                        Line(Smobb, "THIS TEST HAS BEEN A WASTE OF MY TIME."),
                        Line(Smobb, "MY TEST IS OVER. LIVE IN THIS LOOP HOW YOU LIKE."),
                        Effect(Banner("GOODBYE")),
                        Effect(Mood(Normal)),
                    ])),
                    Branch(keys: [], target: Steps([
                        Line(Smobb, "WELL THEN."),
                        Recap("I can save them. I will make the ability now. It is '!SAVE'. I will warn everyone before it happens."),
                        Line(Smobb, "WELCOME TO HELL."),
                        Line(Smobb, "."),
                        Line(Smobb, "."),
                        Line(Smobb, "."),
                        Effect(Banner("GOODBYE")),
                        Effect(Mood(Normal)),
                    ])),
                ]),
            ]
        ),
    },
)
